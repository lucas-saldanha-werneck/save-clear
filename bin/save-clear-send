#!/usr/bin/env python3
"""save-clear: types /clear (and then the resume request) into the terminal running THIS session.

Started detached by the Stop hook. Modes:
  tmux  <pane>       the session runs in a tmux pane (needs tmux)
  bg    <job id>     a `claude --bg` background session (needs tmux: attaches in a hidden tmux)
(iTerm2 without tmux is not typed into: the prompt cannot be checked there.)

Safety rules:
- Types only when the session is idle (`claude agents --json` says idle, no "esc to interrupt")
  and the prompt is EMPTY. It never erases a draft.
- tmux: before every key, the Claude process in the target must be the session from the flag
  (same sessionId) and the same pid as at the first check. Otherwise it refuses, logs REFUSED,
  exits 3. Right before each Enter it checks again: same session and pid, idle, and the prompt
  holds the text it typed and nothing else. If not, it does not press Enter and leaves the text there.
- /clear is confirmed only when the SAME pid shows a NEW sessionId (tmux) or the job's state
  file shows a new conversation id (bg). Only then is the resume request typed.
- A user message after the save, or a session that goes back to work: it does not clear. It
  re-arms the flag and exits: the next Stop hook decides.

Usage: save-clear-send <tmux|bg> <target> <session_id> <flag-json> <transcript>
       save-clear-send --check <tmux|iterm> <target> <session_id>   (0 ok, 1 refused, 2 unknown)
Test knobs: SAVE_CLEAR_STATE_DIR, SAVE_CLEAR_CLAUDE (a fake `claude`), SAVE_CLEAR_DRY_RUN=1,
            SAVE_CLEAR_BG_WAIT (seconds to wait for a --bg job to go idle, default 60).
"""
import json
import os
import shlex
import subprocess
import sys
import time

sys.path.insert(0, os.path.join(os.path.dirname(os.path.dirname(os.path.abspath(__file__))), "lib"))
from common import (BIN, MARGIN_MS, ancestors, claude_bin, clear_key, draft_why,  # noqa: E402
                    log as _log, notify, now_ms, prompt_block, prompt_text, ps_parents, resume_msg,
                    run_hook_command, short, squash, tmux_bin, user_messages_since, write_clear)

CLAUDE = claude_bin()
RESUME_MSG = resume_msg()  # the resume_message option, else the default text
TMUX = tmux_bin() or "tmux"
DRY = os.environ.get("SAVE_CLEAR_DRY_RUN") == "1"
MAX_WAIT = int(os.environ.get("SAVE_CLEAR_MAX_WAIT", "1200"))  # 20 min waiting for the session to be free
BG_WAIT = float(os.environ.get("SAVE_CLEAR_BG_WAIT", "60"))

CHECK = len(sys.argv) > 1 and sys.argv[1] == "--check"
flag_json, transcript = "{}", ""
if CHECK:
    mode, target, sid = (sys.argv[2:] + ["", "", ""])[:3]
else:
    mode, target, sid, flag_json, transcript = (sys.argv[1:] + ["", "", "", "{}", ""])[:5]


def log(msg):
    _log(f"{'check ' if CHECK else ''}{mode} {target}", msg)


def sh(cmd, timeout=20):
    try:
        return subprocess.run(cmd, capture_output=True, text=True, timeout=timeout).stdout
    except Exception:
        return ""


def pane_pid():
    for ln in sh([TMUX, "list-panes", "-a", "-F", "#{pane_pid} #{pane_id}"]).splitlines():
        parts = ln.split()
        if len(parts) == 2 and parts[1] == target:
            return int(parts[0])
    return None


def target_agents():
    """Interactive Claude processes that receive what is typed into the target; None = cannot list."""
    try:
        ags = json.loads(sh([CLAUDE, "agents", "--json"]) or "null")
    except Exception:
        return None
    if not isinstance(ags, list):
        return None
    ags = [a for a in ags if isinstance(a, dict) and a.get("kind") == "interactive" and a.get("pid")]
    if mode == "tmux":
        pp = pane_pid()
        if pp is None:
            return []
        par = ps_parents()
        return [a for a in ags if pp in ancestors(a["pid"], par)]
    want = target[len("/dev/"):] if target.startswith("/dev/") else target  # iterm: /dev/ttys003 -> ttys003
    return [a for a in ags if sh(["ps", "-o", "tty=", "-p", str(a["pid"])]).strip() == want]


def target_agent():
    """(agent, reason). Empty reason = exactly one Claude in the target."""
    ags = target_agents()
    if ags is None:
        return None, "cannot-list"
    if not ags:
        return None, "no-claude"
    if len(ags) > 1:
        return None, "ambiguous (" + ", ".join(f"{short(a.get('sessionId'))}/pid {a['pid']}" for a in ags) + ")"
    return ags[0], ""


# ---------- check only (arm-clear and the Stop hook) ----------
if CHECK:
    if mode not in ("tmux", "iterm") or not target or not sid:
        print("refused: usage --check <tmux|iterm> <target> <session_id>")
        sys.exit(2)
    ag, why = target_agent()
    if ag is None:
        if why != "cannot-list":
            log(f"REFUSED: {why}; expected {short(sid)}")
        print(f"refused: {why} in target {target}")
        sys.exit(2 if why == "cannot-list" else 1)
    if ag.get("sessionId") != sid:
        msg = f"target {target} runs session {short(ag.get('sessionId'))} (pid {ag['pid']}), not {short(sid)}"
        log(f"REFUSED: {msg}")
        print("refused: " + msg)
        sys.exit(1)
    print(f"ok: target {target} runs session {short(sid)} (pid {ag['pid']})")
    sys.exit(0)


# ---------- helper ----------
EXPECT = {"sid": sid, "pid": None}  # who must be in the target before every key


def refuse(why):
    log(f"REFUSED: {why}. Typed nothing; flag not re-armed. Type /clear by hand in the right session.")
    notify(f"save-clear: did not clear - {why}")
    sys.exit(3)


def rearm(why):
    try:
        flag = json.loads(flag_json)
    except Exception:
        flag = {}
    if not flag:
        log(f"not re-armed ({why}): empty flag")
        return
    flag["armed_at"] = now_ms()
    flag["rearms"] = flag.get("rearms", 0) + 1
    if flag["rearms"] > 5:
        log(f"gave up ({why}): already re-armed 5 times")
        notify(f"save-clear: gave up on the automatic /clear ({why}). Type /clear by hand.")
        return
    flag["key"] = flag.get("key") or (clear_key(job=target) if mode == "bg" else clear_key(flag.get("session_id") or sid))
    write_clear(flag)  # this session's own request file only
    log(f"re-armed ({why}); the next end of turn tries again")


def pre_clear():
    """The user's pre_clear_command, once, right before /clear is typed. It never stops the clear."""
    if DRY:
        return
    run_hook_command("pre_clear_command", "pre_clear",
                     {"SAVE_CLEAR_SESSION_ID": sid, "SAVE_CLEAR_MODE": mode, "SAVE_CLEAR_TARGET": target},
                     timeout=20)


def new_messages():
    try:
        since = json.loads(flag_json).get("ts", 0) - MARGIN_MS
    except Exception:
        return []
    return user_messages_since(transcript, since)


# ----- bg mode: no terminal of its own; attach in a hidden tmux, type, detach -----
def job_state():
    try:
        with open(os.path.join(os.path.expanduser("~"), ".claude", "jobs", target, "state.json"), encoding="utf-8") as f:
            v = json.load(f)
        return v if isinstance(v, dict) else {}
    except Exception:
        return {}


def conversation(st):
    """The job's current conversation: a /clear starts a new one."""
    return st.get("resumeSessionId") or st.get("linkScanPath") or ""


def bg_free(s):
    if job_state().get("state") == "working":
        return False, "busy"
    p = screen(s)
    if "esc to interrupt" in p:
        return False, "busy"
    d = prompt_text(p)
    if d is None:
        return False, "no-prompt"
    return (False, "draft") if d else (True, "")


def bg_ready_for_enter(s, text):
    if job_state().get("state") == "working":
        return False, "the job went back to work"
    p = screen(s)
    if "esc to interrupt" in p:
        return False, "busy"
    d = prompt_block(p)
    if d is None or squash(d) != squash(text):
        return False, f"the prompt holds {d!r}, not the typed text"
    return True, ""


def bg_type(s, before):
    ok, why = False, ""
    for _ in range(40):  # 2) idle, empty prompt in the client
        time.sleep(1)
        ok, why = bg_free(s)
        if ok or why == "draft":
            break
    if not ok:
        rearm(f"the background prompt was not free ({why}); typed nothing")
        return 0
    msgs = new_messages()
    if msgs:
        rearm(f"new message after the save ({msgs[-1][:40]!r}); typed nothing")
        notify("save-clear: a message arrived after the save, so the session was not cleared.")
        return 0
    pre_clear()
    sh([TMUX, "send-keys", "-t", s, "-l", "/clear"])
    time.sleep(1)
    ok, why = bg_ready_for_enter(s, "/clear")
    if not ok:
        log(f"REFUSED: check before Enter failed ({why}). Enter not sent; '/clear' is still in the prompt")
        notify("save-clear: did not clear the background session. Type /clear yourself.")
        return 3
    msgs = new_messages()  # a message can arrive during the pause between typing and Enter
    if msgs:
        sh([TMUX, "send-keys", "-t", s, *["BSpace"] * len("/clear")])
        rearm(f"new message while /clear was in the prompt ({msgs[-1][:40]!r}); Enter not sent")
        notify("save-clear: a message arrived after the save, so the session was not cleared.")
        return 0
    sh([TMUX, "send-keys", "-t", s, "Enter"])
    after = ""
    for _ in range(10):
        time.sleep(1)
        after = conversation(job_state())
        if before and after and after != before:
            break
    if not (before and after and after != before):
        log("/clear sent, but the job's state file shows no new conversation id: not confirmed, "
            "resume request not typed")
        notify("save-clear: /clear sent to the background session; the summary comes with your next message.")
        sh([TMUX, "send-keys", "-t", s, "C-z"])
        return 0
    log(f"/clear confirmed (conversation {short(before)} -> {short(after)})")
    for _ in range(15):
        ok, why = bg_free(s)
        if ok or why == "draft":
            break
        time.sleep(1)
    if ok:
        sh([TMUX, "send-keys", "-t", s, "-l", RESUME_MSG])
        time.sleep(1)
        ok, why = bg_ready_for_enter(s, RESUME_MSG)
        if ok:
            sh([TMUX, "send-keys", "-t", s, "Enter"])
            time.sleep(2)
    if not ok:
        log(f"resume request not sent ({why}); the summary comes with the next message")
    sh([TMUX, "send-keys", "-t", s, "C-z"])
    time.sleep(1)
    log("sent /clear (confirmed)" + (" + resume request" if ok else "") + "; client closed")
    return 0


def run_bg():
    if not tmux_bin():
        refuse("bg mode needs tmux, which is not installed")
    t0, st = time.time(), ""
    while True:  # 1) the job leaves "working" (the turn ended)
        st = job_state().get("state", "")
        if st and st != "working":
            break
        if time.time() - t0 > BG_WAIT:
            rearm(f"the job stayed {st or 'unknown'} for {int(BG_WAIT)} s; typed nothing")
            return 0
        time.sleep(1)
    log(f"job state: {st}")
    msgs = new_messages()
    if msgs:
        rearm(f"new message after the save ({msgs[-1][:40]!r}); typed nothing")
        notify("save-clear: a message arrived after the save, so the session was not cleared.")
        return 0
    before = conversation(job_state())
    if DRY:
        log(f"dry-run: would attach {target} and type /clear")
        return 0
    s = f"save-clear-{target}"
    sh([TMUX, "kill-session", "-t", s])
    if subprocess.run([TMUX, "new-session", "-d", "-s", s, "-x", "200", "-y", "50",
                       f"{shlex.quote(CLAUDE)} attach {shlex.quote(target)}"]).returncode != 0:
        log("tmux/attach failed")
        return 1
    try:
        return bg_type(s, before)
    finally:
        sh([TMUX, "kill-session", "-t", s])


def run_iterm():
    refuse("the iTerm2 mode was removed: the helper cannot check for an empty prompt there")


# ----- tmux mode -----
def ours():
    """The Claude in the pane, checked: the expected session and the same process. Else refuse and EXIT."""
    ag, why = target_agent()
    if ag is None:
        if why.startswith("ambiguous"):
            refuse(f"more than one Claude in the pane: {why}")
        return None, why
    if ag.get("sessionId") != EXPECT["sid"]:
        refuse(f"the pane runs session {short(ag.get('sessionId'))} (pid {ag['pid']}), "
               f"but the flag belongs to {short(EXPECT['sid'])}")
    if EXPECT["pid"] is None:
        EXPECT["pid"] = ag["pid"]
    elif ag["pid"] != EXPECT["pid"]:
        refuse(f"the pane's process changed (pid {EXPECT['pid']} -> {ag['pid']})")
    return ag, ""


def keys(*args):
    if DRY:
        log("dry-run: would type " + repr(args))
        return
    sh([TMUX, "send-keys", "-t", target, *args])


def screen(t=None):
    # -e keeps colors: the empty-prompt hint is dim (ESC[2m); a real draft is not.
    return sh([TMUX, "capture-pane", "-p", "-e", "-t", t or target])


def ready_for_enter(text):
    """Right before Enter: same session and pid, idle, and the prompt holds exactly `text`."""
    ag, why = ours()
    if ag is None:
        return False, why or "no Claude in the pane"
    if ag.get("status") != "idle":
        return False, "busy"
    s = screen()
    if "esc to interrupt" in s:
        return False, "busy"
    p = prompt_block(s)
    if p is None or squash(p) != squash(text):
        return False, f"the prompt holds {p!r}, not the typed text"
    return True, ""


def press_enter(text):
    """Enter only after ready_for_enter; otherwise refuse and leave the typed text in the prompt."""
    if DRY:
        keys("Enter")
        return
    ok, why = ready_for_enter(text)
    if not ok:
        refuse(f"check before Enter failed ({why}). Enter not sent; {text[:30]!r} is still in the prompt")
    if text == "/clear":
        msgs = new_messages()  # a message can arrive during the pause between typing and Enter
        if msgs:
            keys(*["BSpace"] * len(text))  # the prompt holds exactly our text (just checked): erase it
            rearm(f"new message while /clear was in the prompt ({msgs[-1][:40]!r}); Enter not sent")
            notify("save-clear: a message arrived after the save, so the session was not cleared.")
            sys.exit(0)
    keys("Enter")


def free():
    """(free, reason). Free = expected session + idle + empty prompt."""
    ag, why = ours()
    if ag is None:
        return False, why
    if ag.get("status") != "idle":
        return False, "busy"
    s = screen()
    if "esc to interrupt" in s:
        return False, "busy"
    p = prompt_text(s)
    if p is None:
        return False, "no-prompt"
    if p:
        return False, draft_why(s)
    return True, ""


def trigger():
    return ("save-clear (automatic): your message arrived after the save. Add to the snapshot only what came "
            "after it (section \"## After the save\") and run: python3 \"" + os.path.join(BIN, "save-clear")
            + "\" rearm " + EXPECT["sid"] + ". The /clear follows.")


def stop_if_new(step):
    """A user message after the save: do not clear. Re-arm and, if free, ask Claude to save the rest."""
    msgs = new_messages()
    if not msgs:
        return
    rearm(f"{step}: new message after the save ({msgs[-1][:40]!r})")
    ok, _ = free()
    if ok:
        text = trigger()
        keys("-l", text)
        time.sleep(1)
        press_enter(text)
        log("asked Claude to save what came after")
    sys.exit(0)


def type_line(text):
    """Types only if the pane still runs the expected session with an empty prompt; Enter only if
    it still does and the prompt holds exactly `text`."""
    ok, why = free()
    if not ok:
        return False, why
    keys("-l", text)
    time.sleep(1)  # separate Enter: long text becomes a "paste" and swallows the Enter
    press_enter(text)  # checks owner, idle and the exact prompt again; refuses and exits if changed
    return True, ""


def cleared_now():
    """New sessionId in the SAME process = our /clear took."""
    ag, _ = target_agent()
    if ag and ag["pid"] == EXPECT["pid"] and ag.get("sessionId") and ag["sessionId"] != EXPECT["sid"]:
        return ag["sessionId"]
    return None


def run_tmux():
    time.sleep(float(os.environ.get("SAVE_CLEAR_START_DELAY", "2")))  # let the other Stop hooks finish
    # 1) Wait until free. If Claude goes back to work, it is the Stop hook's turn: re-arm.
    t0, last, busy_since = time.time(), "", None
    while True:
        ok, why = free()
        if ok:
            stop_if_new("before starting")
            break
        if why == "busy":
            busy_since = busy_since or time.time()
            if time.time() - busy_since > 8:
                rearm("the session went back to work: new message or another hook")
                return 0
        else:
            busy_since = None
        if why != last:
            log(f"waiting: {why}")
            last = why
        if time.time() - t0 > MAX_WAIT:
            rearm(f"waited {MAX_WAIT}s and it stayed {why}")
            return 0
        time.sleep(2)
    log(f"target checked: pane {target} runs session {short(EXPECT['sid'])} (pid {EXPECT['pid']})")

    # 2) /clear, then confirm the sessionId changed in the same process
    new_sid = None
    stop_if_new("before /clear")
    pre_clear()
    for attempt in (1, 2):
        stop_if_new("before /clear")
        sent, why = False, ""
        for _ in range(5):
            sent, why = type_line("/clear")
            if sent or why != "busy":
                break
            time.sleep(1)
        if not sent:
            rearm(f"before /clear: {why}")
            return 0
        if DRY:
            log("dry-run: stopped before confirming /clear (nothing was typed)")
            return 0
        for _ in range(10):
            time.sleep(1)
            new_sid = cleared_now()
            if new_sid:
                break
        if new_sid:
            break
        if prompt_text(screen()) == "/clear":  # typed but the Enter was lost
            new_sid = cleared_now()
            if new_sid:
                break
            press_enter("/clear")
            time.sleep(3)
            new_sid = cleared_now()
            if new_sid:
                break
        log(f"/clear attempt {attempt}: sessionId did not change")
    if not new_sid:
        rearm("the /clear did not take")
        notify("save-clear: the automatic /clear did not take. Type /clear by hand.")
        return 1
    log(f"/clear confirmed (sessionId {short(EXPECT['sid'])} -> {short(new_sid)}, same process pid {EXPECT['pid']})")
    EXPECT["sid"] = new_sid

    # 3) Resume request (wait for the new session to be ready)
    time.sleep(2)
    for _ in range(15):
        sent, why = type_line(RESUME_MSG)
        if sent:
            break
        if why.startswith("draft"):
            log("resume request not sent: the user is already typing")
            return 0
        time.sleep(2)
    else:
        log("resume request not sent: the session was not free within 30 s")
        return 1
    time.sleep(3)
    if squash(prompt_block(screen())) == squash(RESUME_MSG):  # Enter swallowed by the paste
        press_enter(RESUME_MSG)
    log("sent /clear (confirmed) + resume request")
    notify("save-clear: session saved and cleared.")
    return 0


log(f"helper started (session {short(sid)})")
if mode == "bg":
    sys.exit(run_bg())
if not sid:
    refuse("the hook did not pass the expected session_id")
if mode == "iterm":
    sys.exit(run_iterm())
if mode == "tmux":
    sys.exit(run_tmux())
refuse(f"unknown mode {mode!r}")
