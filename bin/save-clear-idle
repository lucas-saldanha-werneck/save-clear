#!/usr/bin/env python3
"""save-clear-idle: a Claude Code session left idle for N minutes runs save-clear by itself.

Opt-in. Nothing runs this until you schedule it (`./install.sh --idle` on macOS writes a launchd
job that runs it every 2 minutes; on Linux, add the cron line that `./install.sh --idle` prints).

Why: it targets Claude Code's 1-hour prompt cache. Until the cache expires, coming back to a big
session reads the context cheaply from it; after that, the whole context is written to the cache
again at full price. At ~50 minutes idle, save-clear swaps a big context for a short summary while
the cache is still warm. It does not check which cache length your account gets (with the 5-minute
cache it is already cold by then); see the README.

It types a save-clear request into a session only when ALL of these hold:
  - the setting idle_minutes is not 0 ($SAVE_CLEAR_IDLE_MINUTES, plugin option, or --idle-min);
  - `claude agents --json` lists the session as interactive and idle;
  - nothing in the session changed for idle_minutes .. min(idle_minutes+8, 59) minutes (transcript,
    subagent files, background task output). Past that window the cache is gone anyway;
  - the context is at least idle_min_tokens (default 80000);
  - the session has not armed its own /clear and did not arm a resume in the last 15 minutes;
  - after an automatic resume, the context grew at least 40k tokens (no save loop on a session that
    only re-read its summary);
  - it did not act already during this same idle stretch (a stretch ends when the transcript changes;
    a request that got no reply at all is logged once as no-response and not typed again);
  - the transcript does not already hold an idle request with nothing from the user after it. A
    session that was asked and still has the same id did not clear (a usage limit, a failed /clear,
    or the same session open in several panes, which share one transcript): asking again every hour
    only saves the same context again. It asks again once the user writes something;
  - it did not already ask this session id twice (MAX_ASKS). A /clear gives the session a new id, so
    two requests on one id mean it did not clear twice: it logs `gave-up`, runs the notify command
    once and leaves that session alone;
  - the session runs in a tmux pane, the pane runs exactly that session, the prompt is empty, and
    right before Enter the prompt holds exactly the typed text and the session is still idle.
    Otherwise it types nothing, or does not press Enter and erases its text if the prompt still holds
    exactly that.

Sessions outside tmux (plain terminal, iTerm2 without tmux, desktop app, IDE) are skipped and
logged: there is no safe way to check for an empty prompt there.

It lists the transcripts first and runs `claude agents --json` only when one of them is in the
window, so most runs start no extra process.

Usage: save-clear-idle [--dry-run] [--only <session id>] [--idle-min N] [--max-min N] [--min-tokens N]
Log:   save-clear.log in the state folder, tag [idle]. With --dry-run or --only it also prints JSON lines.
Test knobs: SAVE_CLEAR_CLAUDE (a fake `claude`; a .py file runs with this Python),
            SAVE_CLEAR_PROJECTS_DIR (default ~/.claude/projects), SAVE_CLEAR_IDLE_TYPE_DELAY.
"""
import argparse
import glob
import json
import os
import re
import subprocess
import sys
import tempfile
import time

sys.path.insert(0, os.path.join(os.path.dirname(os.path.dirname(os.path.abspath(__file__))), "lib"))
import resume  # noqa: E402
from common import (HOME, NOT_HUMAN, RESUME_MSG, STATE, resume_msg, is_resume_text, ancestors, claude_bin,  # noqa: E402
                    clear_key, clear_path, draft_why, log as _log, notify, now_ms, prompt_block, ps_parents, setting,
                    short, squash, tail_lines, tmux_bin)

DEFAULT_IDLE_MIN = 50
WINDOW_MIN = 8            # act between idle_min and idle_min + 8 minutes ...
LAST_MIN = 59             # ... and never later than this: the 1-hour cache is gone at 60
DEFAULT_MIN_TOKENS = 80000
GROWTH_AFTER_RESUME = 40000
RECENT_SAVE_MS = 15 * 60 * 1000
NO_REPLY_S = 60           # a typed request with no transcript change after this long = no response
IDLE_DIR = os.path.join(STATE, "idle")
MSG = ("save-clear (automatic: session idle for {m} min, context {k}k; saving before the prompt cache expires). "
       "Run the save-clear skill now in \"save and clear\" mode. If your last message was a question to the "
       "user, put that question under next steps.")
MSG_START = MSG.split("{")[0]
MAX_ASKS = 2              # requests typed into one session id; a /clear gives the session a new id
KEEP = ("asks", "gave_up")  # mark fields that outlive an idle stretch


def number(name, default):
    raw = setting(name, str(default)).replace("_", "").replace(",", "")
    try:
        return max(0.0, float(raw))
    except ValueError:
        _log("idle", f"bad {name} {raw!r}; using {default}")
        return float(default)


ap = argparse.ArgumentParser(description="Run save-clear in sessions left idle (opt-in).")
ap.add_argument("--dry-run", action="store_true", help="only print what it would do")
ap.add_argument("--only", help="look at this session id only")
ap.add_argument("--idle-min", type=float, default=None, help="minutes idle before acting (0 = off)")
ap.add_argument("--max-min", type=float, default=None, help="do not act after this many idle minutes")
ap.add_argument("--min-tokens", type=int, default=None, help="skip sessions with a smaller context")
a = ap.parse_args()
IDLE_MIN = a.idle_min if a.idle_min is not None else number("idle_minutes", DEFAULT_IDLE_MIN)
MAX_MIN = min(a.max_min if a.max_min is not None else IDLE_MIN + WINDOW_MIN, LAST_MIN)
MIN_TOKENS = a.min_tokens if a.min_tokens is not None else int(number("idle_min_tokens", DEFAULT_MIN_TOKENS))
CLAUDE = claude_bin()
TMUX = tmux_bin()
PROJECTS = os.path.expanduser(os.environ.get("SAVE_CLEAR_PROJECTS_DIR") or os.path.join(
    os.environ.get("CLAUDE_CONFIG_DIR") or os.path.join(HOME, ".claude"), "projects"))
TYPE_DELAY = float(os.environ.get("SAVE_CLEAR_IDLE_TYPE_DELAY", "1"))


def log(**kw):
    kw = {k: v for k, v in kw.items() if v is not None}
    _log("idle", json.dumps(kw, ensure_ascii=False))
    if a.dry_run or a.only:
        print(json.dumps(kw, ensure_ascii=False))


def sh(cmd, timeout=30):
    try:
        return subprocess.run(cmd, capture_output=True, text=True, timeout=timeout).stdout
    except Exception:
        return ""


def agents():
    cmd = ([sys.executable, CLAUDE] if CLAUDE.endswith(".py") else [CLAUDE]) + ["agents", "--json"]
    try:
        v = json.loads(sh(cmd) or "null")
    except Exception:
        return None
    return v if isinstance(v, list) else None


def task_dirs(sid):
    """Background task output of a session (Claude Code keeps it in a per-user temp folder)."""
    uid = os.getuid() if hasattr(os, "getuid") else None
    roots = {tempfile.gettempdir()}
    if sys.platform == "darwin":
        roots.add("/private/tmp")
    out = []
    for r in roots:
        pattern = os.path.join(r, f"claude-{uid}" if uid is not None else "claude-*", "*", sid, "tasks", "*")
        out += glob.glob(pattern)
    return out


def last_change(sid, transcript):
    """Newest mtime among the transcript, the session folder (subagents) and background tasks."""
    paths = [transcript] + glob.glob(transcript[:-len(".jsonl")] + "/**/*", recursive=True) + task_dirs(sid)
    m = 0.0
    for p in paths:
        try:
            m = max(m, os.path.getmtime(p))
        except OSError:
            pass
    return m


def usage_total(line):
    try:
        d = json.loads(line)
    except Exception:
        return None
    if not isinstance(d, dict) or d.get("isSidechain"):
        return None
    msg = d.get("message")
    u = msg.get("usage") if isinstance(msg, dict) else None
    if not isinstance(u, dict):
        return None
    total = sum(int(u.get(k) or 0) for k in ("input_tokens", "cache_read_input_tokens", "cache_creation_input_tokens"))
    return total or None  # a synthetic reply has all zeros


def last_context(tp):
    for line in reversed(tail_lines(tp, 4 * 1024 * 1024)):
        if '"usage"' in line:
            t = usage_total(line)
            if t:
                return t
    return 0


def is_resume_request(line, custom):
    """A top-level user message whose text is the resume request save-clear types (not a tool result
    or a file that merely quotes it). `custom` = resume_msg(), worked out once by the caller."""
    # quick filter on the raw line, in its JSON-escaped form (quotes and backslashes are escaped there;
    # non-ASCII text may be \u-escaped, so only ASCII probes filter)
    probe = json.dumps(custom[:20], ensure_ascii=False)[1:-1]
    if RESUME_MSG[:20] not in line and probe.isascii() and probe not in line:
        return False
    try:
        d = json.loads(line)
    except Exception:
        return False
    if not isinstance(d, dict) or d.get("type") != "user" or d.get("isSidechain"):
        return False
    msg = d.get("message")
    content = msg.get("content") if isinstance(msg, dict) else None
    return isinstance(content, str) and (content.lstrip().startswith(RESUME_MSG) or is_resume_text(content, custom))


def resume_baseline(tp):
    """Context size right after the last automatic resume, or None if there was none."""
    base, seen = None, False
    custom = resume_msg()
    for line in tail_lines(tp, 8 * 1024 * 1024):
        if is_resume_request(line, custom):
            seen, base = True, None
            continue
        if seen and base is None and '"usage"' in line:
            base = usage_total(line)
    return base


def asked_and_silent(tp):
    """True when the transcript already holds an idle request and the user wrote nothing after it.

    The user's own words = a typed or queued message; not a tool result, a hook or skill text, a
    resume request or another automatic save-clear request."""
    custom = resume_msg()
    asked, words = False, 0
    for line in tail_lines(tp, 8 * 1024 * 1024):
        try:
            d = json.loads(line)
        except Exception:
            continue
        if not isinstance(d, dict) or d.get("isSidechain") or d.get("isMeta"):
            continue
        kind, txt = d.get("type"), ""
        if kind == "attachment":
            att = d.get("attachment")
            if isinstance(att, dict) and att.get("type") == "queued_command":
                txt = att.get("prompt")
        elif kind == "queue-operation" and d.get("operation") == "enqueue":
            txt = d.get("content")
        elif kind == "user":
            msg = d.get("message")
            c = msg.get("content") if isinstance(msg, dict) else None
            if isinstance(c, list):
                if any(isinstance(b, dict) and b.get("type") == "tool_result" for b in c):
                    continue
                c = " ".join(b.get("text", "") for b in c if isinstance(b, dict) and b.get("type") == "text")
            txt = c
        txt = txt.strip() if isinstance(txt, str) else ""
        if not txt:
            continue
        if txt.startswith(MSG_START):
            asked, words = True, 0
        elif asked and not NOT_HUMAN.match(txt) and not is_resume_text(txt, custom):
            words += 1
    return asked and not words


def armed_or_saving(sid):
    if os.path.exists(clear_path(clear_key(sid))):
        return "this session already armed its /clear"
    now = now_ms()
    for e in resume.read_entries() or []:
        if e.get("session_id") == sid and now - int(e.get("ts") or 0) < RECENT_SAVE_MS:
            return "this session armed a resume in the last 15 minutes"
    return ""


def mark_path(sid):
    return os.path.join(IDLE_DIR, re.sub(r"[^A-Za-z0-9_-]", "", sid)[:120] + ".done")


def read_mark(sid):
    """{"mt": last change of the idle stretch already handled, "sent_at": when a request was typed}."""
    try:
        with open(mark_path(sid), encoding="utf-8") as f:
            raw = f.read().strip()
    except OSError:
        return {"mt": 0.0}
    try:
        v = json.loads(raw)
    except ValueError:
        v = None
    if isinstance(v, (int, float)):  # 0.5.0 wrote a bare number
        return {"mt": float(v)}
    if isinstance(v, dict):
        try:
            v["mt"] = float(v.get("mt") or 0)
            return v
        except (TypeError, ValueError):
            pass
    return {"mt": 0.0}


def write_mark(sid, mt, **extra):
    if a.dry_run:
        return
    os.makedirs(IDLE_DIR, exist_ok=True)
    with open(mark_path(sid), "w", encoding="utf-8") as f:
        json.dump(dict(mt=mt, **extra), f)


def note_no_transcripts():
    """Log once (until transcripts show up again) that the projects folder holds none: usually a
    scheduler started without the CLAUDE_CONFIG_DIR the sessions use."""
    flag = os.path.join(IDLE_DIR, "no-transcripts")
    if os.path.exists(flag) and not (a.dry_run or a.only):
        return
    log(event="error", why=f"no transcripts under {PROJECTS} (set CLAUDE_CONFIG_DIR for the scheduler?)")
    if not a.dry_run:
        os.makedirs(IDLE_DIR, exist_ok=True)
        open(flag, "w").close()


# ----- tmux -----
def pane_of(pid):
    if not TMUX:
        return None
    panes = {}
    for ln in sh([TMUX, "list-panes", "-a", "-F", "#{pane_pid} #{pane_id}"]).splitlines():
        parts = ln.split()
        if len(parts) == 2 and parts[0].isdigit():
            panes[int(parts[0])] = parts[1]
    if not panes:
        return None
    for p in ancestors(int(pid), ps_parents()):
        if p in panes:
            return panes[p]
    return None


def pane_agent(pane, ags=None):
    """The single interactive Claude in the pane, or None. ags: a `claude agents` list fetched moments
    ago; None fetches a fresh one."""
    if ags is None:
        ags = agents() or []
    pp = None
    for ln in sh([TMUX, "list-panes", "-a", "-F", "#{pane_pid} #{pane_id}"]).splitlines():
        parts = ln.split()
        if len(parts) == 2 and parts[1] == pane and parts[0].isdigit():
            pp = int(parts[0])
    if pp is None:
        return None
    par = ps_parents()
    found = [g for g in ags if isinstance(g, dict) and g.get("kind") == "interactive" and g.get("pid")
             and pp in ancestors(int(g["pid"]), par)]
    return found[0] if len(found) == 1 else None


def screen(pane):
    return sh([TMUX, "capture-pane", "-p", "-e", "-t", pane])


def pane_state(pane, sid, pid, ags=None):
    """'' when the pane runs session sid in process pid, idle; else the reason."""
    ag = pane_agent(pane, ags)
    if not ag:
        return "no single Claude in the pane"
    if ag.get("sessionId") != sid or int(ag.get("pid") or 0) != int(pid):
        return f"the pane now runs session {short(ag.get('sessionId'))}"
    if ag.get("status") != "idle":
        return "busy"
    return ""


def type_into(pane, sid, pid, msg, ags):
    """Type msg and press Enter, with the checks described at the top. Returns (sent, why).
    ags: the list main() fetched a moment ago; the check right before Enter fetches a fresh one."""
    why = pane_state(pane, sid, pid, ags)
    if why:
        return False, why
    s = screen(pane)
    if "esc to interrupt" in s:
        return False, "busy"
    p = prompt_block(s)
    if p is None:
        return False, "no prompt on screen"
    if p:
        return False, "the prompt has a " + draft_why(s)
    sh([TMUX, "send-keys", "-t", pane, "-l", msg])
    time.sleep(TYPE_DELAY)  # separate Enter: long text arrives as a paste and swallows the Enter
    why = pane_state(pane, sid, pid)
    s = screen(pane)
    if not why and "esc to interrupt" in s:
        why = "busy"
    if not why and squash(prompt_block(s)) != squash(msg):
        why = "the prompt changed while typing"
    if why:
        if squash(prompt_block(s)) == squash(msg):
            sh([TMUX, "send-keys", "-t", pane, *["BSpace"] * len(msg)])  # exactly our text: erase it
            return False, f"check before Enter failed ({why}); Enter not sent, the typed text was erased"
        return False, f"check before Enter failed ({why}); Enter not sent, the prompt was left as it is"
    sh([TMUX, "send-keys", "-t", pane, "Enter"])
    return True, ""


def candidates(now):
    """{session id: transcript} for transcripts last written inside the window. Cheap: no process."""
    tps = glob.glob(os.path.join(PROJECTS, "*", "*.jsonl"))
    if not tps:
        note_no_transcripts()
        return {}
    try:
        os.unlink(os.path.join(IDLE_DIR, "no-transcripts"))
    except OSError:
        pass
    out = {}
    for tp in tps:
        sid = os.path.basename(tp)[:-len(".jsonl")]
        if a.only and sid != a.only:
            continue
        try:
            idle = (now - os.path.getmtime(tp)) / 60
        except OSError:
            continue
        if IDLE_MIN <= idle <= MAX_MIN:
            out[sid] = tp
        elif a.only:
            log(event="skipped", session=sid, why=f"idle {idle:.0f} min, outside {IDLE_MIN:g}-{MAX_MIN:g}")
    if a.only and not out and not any(os.path.basename(tp) == a.only + ".jsonl" for tp in tps):
        log(event="skipped", session=a.only, why=f"no transcript under {PROJECTS}")
    return out


def main():
    if not IDLE_MIN:
        if a.dry_run or a.only:
            print("save-clear-idle: off (idle_minutes = 0)")
        return 0
    if IDLE_MIN >= MAX_MIN:
        log(event="error", why=f"idle_minutes {IDLE_MIN:g} leaves no window: it must be below {MAX_MIN:g} "
                               f"(the 1-hour cache is gone at 60); doing nothing")
        return 0
    now = time.time()
    cands = candidates(now)
    if not cands:
        return 0  # nothing in the window: no need to ask `claude agents`
    ags = agents()
    if ags is None:
        log(event="error", why=f"`{CLAUDE} agents --json` failed")
        return 1
    for ag in ags:
        if not isinstance(ag, dict):
            continue
        sid = str(ag.get("sessionId") or "")
        if sid not in cands:
            continue
        if ag.get("kind") != "interactive" or ag.get("status") != "idle":
            continue
        tp = cands[sid]
        mt = last_change(sid, tp)
        idle = (now - mt) / 60
        if not (IDLE_MIN <= idle <= MAX_MIN):
            if a.only:
                log(event="skipped", session=sid, why=f"idle {idle:.0f} min, outside {IDLE_MIN:g}-{MAX_MIN:g}")
            continue
        info = dict(session=sid, name=ag.get("name"), cwd=ag.get("cwd"), idle_min=round(idle))
        mark = read_mark(sid)
        keep = {k: mark[k] for k in KEEP if k in mark}
        if mark["mt"] >= mt:
            sent_at = mark.get("sent_at")
            if sent_at and not mark.get("reported") and now - float(sent_at) >= NO_REPLY_S:
                # Enter went in but the session wrote nothing: not even our message reached it.
                log(event="no-response", why="the request was typed and Enter pressed, but the session did not "
                                             "change since; not typing again in this idle stretch", **info)
                write_mark(sid, mark["mt"], sent_at=sent_at, reported=True, **keep)
            continue  # already acted (or decided to skip) during this idle stretch
        ctx = last_context(tp)
        info["ctx"] = ctx
        if ctx < MIN_TOKENS:
            log(event="skipped", why=f"context below {MIN_TOKENS}", **info)
            write_mark(sid, mt, **keep)
            continue
        busy = armed_or_saving(sid)
        if busy:
            log(event="skipped", why=busy, **info)
            write_mark(sid, mt, **keep)
            continue
        base = resume_baseline(tp)
        if base is not None and ctx - base < GROWTH_AFTER_RESUME:
            log(event="skipped", why=f"little new since the automatic resume ({base // 1000}k -> {ctx // 1000}k)", **info)
            write_mark(sid, mt, **keep)
            continue
        if asked_and_silent(tp):
            # Same session id as when it was asked = it did not clear (usage limit, failed /clear, or
            # another pane open on the same session). Asking again only saves the same context again.
            log(event="skipped", why="already asked to save and the user wrote nothing since", **info)
            write_mark(sid, mt, **keep)
            continue
        try:
            asks = int(mark.get("asks") or 0)
        except (TypeError, ValueError):
            asks = 0
        if asks >= MAX_ASKS:
            if not mark.get("gave_up"):
                log(event="gave-up", why=f"asked {asks} times and the session did not clear; not asking again", **info)
                if not a.dry_run:
                    notify(f"save-clear: session {ag.get('name') or short(sid)} was asked {asks} times to save and "
                           f"clear while idle and did not clear. Not asking again; run save-clear there yourself.")
                keep["gave_up"] = True
            write_mark(sid, mt, **keep)
            continue
        pane = pane_of(ag.get("pid") or 0)
        if not pane:
            log(event="skipped", why="not in a tmux pane (no safe way to check the prompt)", **info)
            write_mark(sid, mt, **keep)
            continue
        if a.dry_run:
            log(event="would-type", target=pane, **info)
            continue
        sent, why = type_into(pane, sid, ag.get("pid"), MSG.format(m=round(idle), k=round(ctx / 1000)), ags)
        if sent:
            # The stretch ends when the transcript changes (our message lands there). A later stretch
            # gets a new request only after the user wrote something, and at most MAX_ASKS in all.
            keep["asks"] = asks + 1
            write_mark(sid, mt, sent_at=time.time(), **keep)
            log(event="sent", target=pane, **info)
        else:
            log(event="skipped", target=pane, why=why, **info)
            if "Enter not sent" in why:
                write_mark(sid, mt, **keep)  # do not type again during this idle stretch
    return 0


if __name__ == "__main__":
    sys.exit(main())
