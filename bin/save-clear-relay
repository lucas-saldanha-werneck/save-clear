#!/usr/bin/env python3
"""save-clear relay: optional helper for the Claude desktop app.

Why: in the desktop app a session clears itself with clear_session("self"), but it cannot send a
message to itself, so the resume would only arrive with the user's next message. The relay is one
long-lived, cheap app session that serves every session: it listens on an inbox folder, waits for
the target's clear, and sends the resume prompt with send_message. The cleared session restarts on
its own, and nothing is ever typed into a text box.

  save-clear-relay ensure               run in an app session: make sure a usable relay exists (creates one
                                        when none is configured or the configured one is archived)
  save-clear-relay setup [local_<id>]   record an existing session as the relay (default: the caller's own id)
  save-clear-relay rules                the rules the relay session follows (paths filled in)
  save-clear-relay waker-rules          the rules the waker session follows (paths filled in)
  save-clear-relay status               relay id, listening or not, queued, unacknowledged and failed requests
  save-clear-relay off | on             turn the relay off on purpose / back on
  save-clear-relay request              the calling app session asks for its resume after its clear
  save-clear-relay job --to local_<id> [--message TEXT] [--after-clear local_<id>] [--in S] [--why W]
  save-clear-relay listen               the relay's listener (run in the background by the relay)
  save-clear-relay ack <name> ok|failed the relay reports a delivery; a request stays pending until then
  save-clear-relay clear-count          how many clears of the relay the app log shows
  save-clear-relay wait-clear --base N  the waker waits until the relay's clear shows up in the app log

Exit codes of `job` and `request`:
  0  queued, the relay is listening
  2  queued, but the relay is NOT listening: wake it with send_message (text printed on stderr)
  3  the relay is turned off on purpose (OFF file): nothing queued
  4  `request` only: no usable relay (none configured, or archived in the app)
  1  bad arguments

Exit codes of `ensure`:
  0  a relay exists (created now, or already there): do the DO lines it prints, then `request`
  3  the relay is off (setting `relay: off`, or the OFF file): nothing created
  5  not a desktop app session: terminal sessions never get a relay
  6  could not create it (reason printed); retried after a cool-down
"""
import argparse
import contextlib
import glob
import json
import os
import re
import shutil
import subprocess
import sys
import time
import uuid

sys.path.insert(0, os.path.join(os.path.dirname(os.path.dirname(os.path.abspath(__file__))), "lib"))
from common import (ROOT, claude_bin, resume_msg, setting, split_command, STATE, ensure_state,  # noqa: E402
                    read_json, write_json)

try:
    import fcntl
except ImportError:  # Windows
    fcntl = None

RELAY = os.path.join(STATE, "relay.json")
OFF = os.path.join(STATE, "relay-OFF")
INBOX = os.path.join(STATE, "relay-inbox")
OUT = os.path.join(INBOX, "out")          # delivered (acknowledged)
CLAIMED = os.path.join(INBOX, "claimed")  # handed to the relay, waiting for its ack
FAILED = os.path.join(INBOX, "failed")    # gave up: shown by status
ALIVE = os.path.join(STATE, "relay-listener.alive")
LOCK = os.path.join(STATE, "relay-listener.lock")
RLOG = os.path.join(STATE, "relay.log")
SELF = os.path.abspath(__file__)
CMD = f'python3 "{SELF}"'
ID_RE = re.compile(r"local_[0-9a-f-]{36}")
ALIVE_S = 60          # a heartbeat older than this = not listening
AFTER_CLEAR_MAX = 900  # 15 min without the target's clear: drop the request
POLL = float(os.environ.get("SAVE_CLEAR_RELAY_POLL", "3"))
MAXWAIT = float(os.environ.get("SAVE_CLEAR_RELAY_MAXWAIT", str(6 * 3600)))  # exit so the relay re-arms
GRACE = float(os.environ.get("SAVE_CLEAR_RELAY_GRACE", "60"))  # app log missing: deliver after this
CLAIM_S = float(os.environ.get("SAVE_CLEAR_RELAY_CLAIM_S", "600"))  # no ack after this: hand it out again
MAX_ATTEMPTS = 3
CREATE_LOCK = os.path.join(STATE, "relay-create.lock")
COOLDOWN = os.path.join(STATE, "relay-create.failed")
COOLDOWN_S = float(os.environ.get("SAVE_CLEAR_RELAY_COOLDOWN_S", "3600"))
IMPORT_S = float(os.environ.get("SAVE_CLEAR_RELAY_IMPORT_S", "40"))  # wait for the app to import the new session
DEFAULT_TITLE = "Don't touch it, relay"
DEFAULT_MODEL = "haiku"
# Permission modes the CLI takes. A relay in plan mode could not run its listener: plan -> default.
CLI_MODES = ("default", "acceptEdits", "bypassPermissions", "auto", "dontAsk")


def app_log():
    """The desktop app's main log, where it writes 'Clearing session <id>'."""
    env = os.environ.get("SAVE_CLEAR_APP_LOG")
    if env:
        return os.path.expanduser(env)
    if sys.platform == "darwin":
        return os.path.expanduser("~/Library/Logs/Claude/main.log")
    if os.name == "nt":
        return os.path.join(os.environ.get("APPDATA", ""), "Claude", "logs", "main.log")
    return os.path.expanduser("~/.config/Claude/logs/main.log")


def app_sessions_dir():
    """Where the desktop app keeps one JSON per session (title, model, permissionMode, isArchived)."""
    env = os.environ.get("SAVE_CLEAR_APP_SESSIONS")
    if env:
        return os.path.expanduser(env)
    if sys.platform == "darwin":
        return os.path.expanduser("~/Library/Application Support/Claude/claude-code-sessions")
    if os.name == "nt":
        return os.path.join(os.environ.get("APPDATA", ""), "Claude", "claude-code-sessions")
    return os.path.expanduser("~/.config/Claude/claude-code-sessions")


def app_session(sid):
    """The app's JSON for local_<id>, or None when it cannot be found (unknown, not "gone")."""
    if not ID_RE.fullmatch(sid or ""):
        return None
    hits = glob.glob(os.path.join(glob.escape(app_sessions_dir()), "**", sid + ".json"), recursive=True)
    for p in sorted(hits, key=lambda h: os.path.getmtime(h), reverse=True):
        v = read_json(p)
        if isinstance(v, dict):
            return v
    return None


def archived(sid):
    """True / False from the app's session file; None when the file is not found."""
    v = app_session(sid)
    return None if v is None else bool(v.get("isArchived"))


def rlog(msg):
    try:
        ensure_state()
        with open(RLOG, "a", encoding="utf-8") as f:
            f.write(f"{time.strftime('%Y-%m-%d %H:%M:%S')} [relay {os.getpid()}] {msg}\n")
    except OSError:
        pass


def relay_id():
    v = read_json(RELAY)
    return v.get("local_id", "") if isinstance(v, dict) else ""


def listening():
    try:
        with open(ALIVE, encoding="utf-8") as f:
            pid, t = f.read().split()
        if os.name != "nt":
            os.kill(int(pid), 0)
        return time.time() - int(t) < ALIVE_S
    except Exception:
        return False


def wake_text():
    return f"RELAY listen. Run `{CMD} rules` and follow the cycle from step 1."


def enqueue(to, message, after_clear=None, delay=0.0, why=""):
    if os.path.exists(OFF):
        print(f"relay turned off on purpose ({OFF}); nothing queued", file=sys.stderr)
        return 3
    now = time.time()
    job = {"to": to, "message": message, "due": now + delay, "after_clear": after_clear, "why": why, "created": now}
    os.makedirs(INBOX, exist_ok=True)
    name = f"{int(now * 1000)}-{why or 'job'}-{to[6:14]}.json"
    tmp = os.path.join(INBOX, "." + name)
    with open(tmp, "w", encoding="utf-8") as f:
        json.dump(job, f)
    os.replace(tmp, os.path.join(INBOX, name))  # appears only when complete
    print(os.path.join(INBOX, name))
    if not listening():
        rid = relay_id()
        print("WARNING: the relay is not listening; the request waits in the inbox. Wake it: send_message to "
              f"{rid or '(relay id)'} with exactly: {wake_text()}", file=sys.stderr)
        return 2
    return 0


def cmd_job(args):
    ap = argparse.ArgumentParser(prog="save-clear-relay job")
    ap.add_argument("--to", required=True)
    ap.add_argument("--message", default="")
    ap.add_argument("--after-clear", default=None)
    ap.add_argument("--in", dest="delay", type=float, default=0)
    ap.add_argument("--why", default="")
    try:
        a = ap.parse_args(args)
    except SystemExit:
        return 1
    if not a.message:
        print("needs --message", file=sys.stderr)
        return 1
    if not ID_RE.fullmatch(a.to) or (a.after_clear and not ID_RE.fullmatch(a.after_clear)):
        print("invalid id (expected local_<uuid>)", file=sys.stderr)
        return 1
    return enqueue(a.to, a.message, a.after_clear, a.delay, re.sub(r"[^a-z0-9-]", "", a.why.lower())[:20])


def cmd_request():
    me = os.environ.get("CLAUDE_CODE_HOST_SESSION_ID", "")
    rid = relay_id()
    if not rid:
        print("no relay configured: after clear_session the resume arrives with the user's next message. "
              "Say so in the reply.", file=sys.stderr)
        return 4
    if not ID_RE.fullmatch(me):
        print("this is not a desktop app session (no CLAUDE_CODE_HOST_SESSION_ID); the relay cannot help",
              file=sys.stderr)
        return 4
    if archived(rid):
        print(f"the relay {rid} is archived in the app, which ignores archived sessions: nothing queued. "
              f"Run `{CMD} ensure` (it replaces it), or unarchive it in the app.", file=sys.stderr)
        return 4
    if me == rid:
        print(f"this session IS the relay: follow the \"Context full\" part of `{CMD} rules` instead", file=sys.stderr)
        return 1
    return enqueue(me, resume_msg(), after_clear=me, why="save-clear")


def cmd_setup(args):
    rid = args[0] if args else os.environ.get("CLAUDE_CODE_HOST_SESSION_ID", "")
    if not ID_RE.fullmatch(rid or ""):
        print("run this inside the relay app session, or pass its id: setup local_<uuid>", file=sys.stderr)
        return 1
    waker = args[1] if len(args) > 1 and ID_RE.fullmatch(args[1]) else None
    if archived(rid):
        print(f"{rid} is archived in the app: the app ignores archived sessions, so it cannot be the relay. "
              "Unarchive it first, or pick another session.", file=sys.stderr)
        return 1
    ensure_state()
    v = {"local_id": rid, "created": time.strftime("%Y-%m-%dT%H:%M:%S")}
    if waker:
        v["waker"] = waker
    write_json(RELAY, v)
    print(f"relay recorded: {rid}{' (waker ' + waker + ')' if waker else ''} in {RELAY}")
    print(f"Now, in the relay session, send: {wake_text()}")
    return 0


def relay_auto():
    """The `relay` setting: auto (default) creates the relay when needed; off never does."""
    return setting("relay").lower() not in ("off", "0", "false", "no")


def is_app_session():
    """A Claude desktop app session: it has a local_<id> host id and is not a terminal (cli) session."""
    return bool(ID_RE.fullmatch(os.environ.get("CLAUDE_CODE_HOST_SESSION_ID", ""))) and \
        (os.environ.get("CLAUDE_CODE_ENTRYPOINT") or "cli") != "cli"


def cli_mode(mode):
    """The caller's app permission mode, as a CLI --permission-mode value (None = leave the default)."""
    if mode == "plan":
        return "default"
    return mode if mode in CLI_MODES else None


@contextlib.contextmanager
def create_lock():
    """One creator at a time, across processes and platforms (O_EXCL file; stale after 5 minutes)."""
    ensure_state()
    for _ in range(2):
        try:
            fd = os.open(CREATE_LOCK, os.O_CREAT | os.O_EXCL | os.O_WRONLY)
            break
        except FileExistsError:
            try:
                if time.time() - os.path.getmtime(CREATE_LOCK) > 300:
                    os.unlink(CREATE_LOCK)
                    continue
            except OSError:
                continue
            yield False
            return
    else:
        yield False
        return
    try:
        os.write(fd, f"{os.getpid()} {int(time.time())}\n".encode())
        os.close(fd)
        yield True
    finally:
        try:
            os.unlink(CREATE_LOCK)
        except OSError:
            pass


def opener():
    env = os.environ.get("SAVE_CLEAR_OPEN")
    if env:
        return split_command(env)
    if sys.platform == "darwin":
        return [shutil.which("open") or "/usr/bin/open"]
    if os.name == "nt":
        return ["cmd", "/c", "start", ""]
    return [shutil.which("xdg-open") or "xdg-open"]


def log_size():
    try:
        return os.path.getsize(app_log())
    except OSError:
        return 0


def wait_import(pos, sid, timeout):
    """Wait for the app log line that says the deep link imported local_<id>."""
    end = time.time() + timeout
    needle = f"as Desktop session {sid}"
    while True:
        try:
            with open(app_log(), "rb") as f:
                f.seek(pos)
                if needle in f.read().decode("utf8", "replace"):
                    return True
        except OSError:
            pass
        if time.time() >= end:
            return False
        time.sleep(min(1.0, POLL))


def create_relay(caller):
    """Create a new app session for the relay: `claude -p --session-id` makes it, the deep link
    claude://resume imports it into the app. Same permission mode as the caller (sessions in different
    permission modes cannot always message each other), a cheap model, a fixed title."""
    model = setting("relay_model") or DEFAULT_MODEL
    me = app_session(caller) or {}
    mode = cli_mode(me.get("permissionMode") or "")
    folder = os.path.join(STATE, "relay-session")
    os.makedirs(folder, exist_ok=True)
    cli = str(uuid.uuid4())
    sid = "local_" + cli
    first = ("You are the save-clear relay session, created by the save-clear plugin. Do nothing until a message "
             f"starting with 'RELAY listen' arrives; then follow it. Reply only: relay ready.")
    cmd = [claude_bin(), "-p", "--session-id", cli, "--model", model]
    if mode:
        cmd += ["--permission-mode", mode]
    try:
        r = subprocess.run(cmd + [first], cwd=folder, stdin=subprocess.DEVNULL, capture_output=True, text=True,
                           encoding="utf-8", errors="replace", timeout=300)
    except (OSError, subprocess.TimeoutExpired) as e:
        return None, f"could not run {cmd[0]} -p: {e}"
    if r.returncode != 0:
        return None, f"{cmd[0]} -p exited {r.returncode}: {(r.stderr or r.stdout or '').strip()[-300:]}"
    pos = log_size()
    try:
        subprocess.run(opener() + [f"claude://resume?session={cli}"], stdin=subprocess.DEVNULL,
                       capture_output=True, timeout=30, check=True)
    except (OSError, subprocess.SubprocessError) as e:
        return None, f"could not open the claude://resume deep link: {e}"
    if not wait_import(pos, sid, IMPORT_S):
        return None, (f"the app did not import {sid} within {int(IMPORT_S)} s "
                      f"(no 'as Desktop session {sid}' in {app_log()})")
    return {"local_id": sid, "model": model, "permission_mode": mode or "default", "folder": folder}, ""


def ensure_steps(rid, new, caller_mode):
    """The app tool calls only the calling session can make (scripts cannot)."""
    title = setting("relay_title") or DEFAULT_TITLE
    app = app_session(rid) or {}
    steps = []
    if new or (app and app.get("title") != title and v_created_by_plugin()):
        steps.append(f'mcp__ccd_session_mgmt__set_session_title session_id={rid} title="{title}"')
    model = setting("relay_model") or DEFAULT_MODEL
    if new and app and model not in (app.get("model") or ""):
        steps.append(f"mcp__ccd_session_mgmt__set_session_model session_id={rid} model={model}")
    mode = cli_mode(caller_mode or "")
    if app and mode and app.get("permissionMode") and cli_mode(app["permissionMode"]) != mode:
        if new:
            steps.append(f"mcp__ccd_session_mgmt__set_session_permission_mode session_id={rid} mode={caller_mode}")
        else:
            print(f"NOTE: the relay runs in permission mode {app['permissionMode']}, this session in {caller_mode}. "
                  "If its messages do not arrive, set both to the same mode.")
    return steps


def v_created_by_plugin():
    v = read_json(RELAY)
    return isinstance(v, dict) and bool(v.get("created_by"))


def cmd_ensure():
    if not is_app_session():
        print("not a desktop app session: terminal sessions do not use a relay; nothing created", file=sys.stderr)
        return 5
    if os.path.exists(OFF) or not relay_auto():
        print("relay off (setting relay: off, or the OFF file): nothing created", file=sys.stderr)
        return 3
    caller = os.environ["CLAUDE_CODE_HOST_SESSION_ID"]
    caller_mode = (app_session(caller) or {}).get("permissionMode") or ""
    rid = relay_id()
    if rid == caller:
        print(f"this session IS the relay: nothing to do (follow `{CMD} rules`)")
        return 0
    if rid and archived(rid) is not True:
        steps = ensure_steps(rid, False, caller_mode)
        print(f"relay ready: {rid} ({'listening' if listening() else 'not listening yet: request will say how to wake it'})")
        for i, st in enumerate(steps, 1):
            print(f"DO {i}: {st}")
        return 0
    if rid:
        print(f"the relay {rid} is archived in the app (the app ignores archived sessions): creating a new one")
        rlog(f"configured relay {rid} is archived; replacing it")
    try:
        if time.time() - os.path.getmtime(COOLDOWN) < COOLDOWN_S:
            with open(COOLDOWN, encoding="utf-8") as f:
                why = f.read().strip()
            print(f"not creating a relay: the last attempt failed less than {int(COOLDOWN_S / 60)} min ago ({why}). "
                  f"Details in {RLOG}", file=sys.stderr)
            return 6
    except OSError:
        pass
    with create_lock() as got:
        if not got:
            print("another session is creating the relay right now; try `request` (it may say how to wake it)",
                  file=sys.stderr)
            return 6
        now = relay_id()  # someone may have finished while we waited
        if now and now != rid and archived(now) is not True:
            print(f"relay ready: {now} (created by another session just now)")
            return 0
        made, why = create_relay(caller)
        if not made:
            ensure_state()
            with open(COOLDOWN, "w", encoding="utf-8") as f:
                f.write(why[:300] + "\n")
            rlog(f"could not create the relay: {why}")
            print(f"could not create the relay: {why}", file=sys.stderr)
            return 6
        v = {"local_id": made["local_id"], "created": time.strftime("%Y-%m-%dT%H:%M:%S"), "created_by": caller,
             "model": made["model"], "permission_mode": made["permission_mode"]}
        old = read_json(RELAY)
        if isinstance(old, dict) and old.get("waker"):
            v["waker"] = old["waker"]
        if rid:
            v["replaced"] = rid
        write_json(RELAY, v)
        try:
            os.unlink(COOLDOWN)
        except OSError:
            pass
    rid = made["local_id"]
    rlog(f"relay created: {rid} (model {made['model']}, permission mode {made['permission_mode']})")
    print(f"relay created: {rid} (model {made['model']}, permission mode {made['permission_mode']}, "
          f"folder {made['folder']})")
    for i, st in enumerate(ensure_steps(rid, True, caller_mode), 1):
        print(f"DO {i}: {st}")
    print(f"THEN: run `{CMD} request`; it exits 2 (not listening yet) and prints the message that starts the "
          "relay's listener: send it with send_message.")
    return 0


def names(folder):
    return sorted(os.path.basename(p) for p in glob.glob(os.path.join(folder, "*.json*")))


def cmd_status():
    rid = relay_id()
    v = read_json(RELAY) or {}
    unacked, failed = names(CLAIMED), names(FAILED)
    app = app_session(rid) if rid else None
    print(json.dumps({"relay": rid or None, "waker": v.get("waker"), "listening": listening(),
                      "archived": None if app is None else bool(app.get("isArchived")),
                      "title": (app or {}).get("title"), "model": (app or {}).get("model"),
                      "permission_mode": (app or {}).get("permissionMode"),
                      "auto": relay_auto(), "created_by_plugin": bool(v.get("created_by")),
                      "off": os.path.exists(OFF), "queued": len(glob.glob(os.path.join(INBOX, "*.json"))),
                      "unacked": len(unacked), "failed": len(failed), "unacked_requests": unacked,
                      "failed_requests": failed, "state": STATE, "app_log": app_log(),
                      "rules": f"{CMD} rules"}, indent=2))
    return 0


def cmd_rules():
    with open(os.path.join(ROOT, "relay", "RULES.md"), encoding="utf8") as f:
        text = f.read()
    print(text.replace("{RELAY}", CMD).replace("{SAVE_CLEAR}", f'python3 "{os.path.join(ROOT, "bin", "save-clear")}"')
          .replace("{WAKER_RULES}", f'{CMD} waker-rules').replace("{STATE}", STATE))
    return 0


def cmd_waker_rules():
    with open(os.path.join(ROOT, "relay", "WAKER.md"), encoding="utf8") as f:
        print(f.read().replace("{RELAY}", CMD).replace("{STATE}", STATE))
    return 0


# ---------- listener ----------
def _log_lines():
    path = app_log()
    try:
        with open(path, "rb") as f:
            f.seek(max(0, os.path.getsize(path) - 4_000_000))
            return f.read().decode("utf8", "replace").splitlines()
    except OSError:
        return None


def cleared(sid, since):
    """(True/False, or None when the app log cannot be read)."""
    lines = _log_lines()
    if lines is None:
        return None
    needle = f"Clearing session {sid}"
    for line in lines:
        if needle in line:
            try:  # "2026-10-17 14:25:02 [info] ..."
                t = time.mktime(time.strptime(line[:19], "%Y-%m-%d %H:%M:%S"))
            except ValueError:
                continue
            if t >= since - 1:
                return True
    return False


def ready(path):
    try:
        with open(path, encoding="utf-8") as f:
            job = json.load(f)
    except Exception as e:
        rlog(f"unreadable request {path}: {e}")
        os.makedirs(FAILED, exist_ok=True)
        os.replace(path, os.path.join(FAILED, os.path.basename(path) + ".bad"))
        return False
    if time.time() < float(job.get("due") or 0):
        return False
    ac = job.get("after_clear")
    if ac:
        created = float(job.get("created") or os.path.getmtime(path))
        done = cleared(ac, created)
        if done is None:  # no app log on this system: the clear happens when the turn ends; wait a margin
            if time.time() - created >= GRACE:
                rlog(f"{os.path.basename(path)}: app log not found ({app_log()}); delivered after {int(GRACE)} s")
                return True
            return False
        if not done:
            if time.time() - created > AFTER_CLEAR_MAX:
                rlog(f"{os.path.basename(path)}: no clear of {ac} in 15 min; dropped")
                os.makedirs(FAILED, exist_ok=True)
                os.replace(path, os.path.join(FAILED, os.path.basename(path) + ".timeout"))
            return False
    return True


def write_job(path, job):
    tmp = os.path.join(os.path.dirname(path), "." + os.path.basename(path))
    with open(tmp, "w", encoding="utf-8") as f:
        json.dump(job, f)
    os.replace(tmp, path)


def give_back(path, job, why):
    """A request that was not delivered: back to the inbox, or to failed/ after MAX_ATTEMPTS."""
    name = os.path.basename(path)
    if int(job.get("attempts") or 0) >= MAX_ATTEMPTS:
        write_job(os.path.join(FAILED, name), job)
        rlog(f"{name}: {why}; gave up after {MAX_ATTEMPTS} attempts (see status)")
    else:
        write_job(os.path.join(INBOX, name), job)
        rlog(f"{name}: {why}; back in the queue (attempt {job.get('attempts')} of {MAX_ATTEMPTS})")
    os.unlink(path)


def reclaim():
    """Requests handed out but never acknowledged (relay turn lost): retry them."""
    for p in glob.glob(os.path.join(CLAIMED, "*.json")):
        try:
            with open(p, encoding="utf-8") as f:
                job = json.load(f)
        except Exception:
            continue
        if time.time() - float(job.get("claimed") or 0) >= CLAIM_S:
            give_back(p, job, f"no ack within {int(CLAIM_S)} s")


def cmd_ack(args):
    if len(args) < 2 or args[1] not in ("ok", "failed"):
        print("usage: ack <name> ok|failed [reason]", file=sys.stderr)
        return 1
    name = os.path.basename(args[0])
    path = os.path.join(CLAIMED, name)
    try:
        with open(path, encoding="utf-8") as f:
            job = json.load(f)
    except Exception:
        print(f"{name}: not waiting for an ack (already acknowledged, or retried)", file=sys.stderr)
        return 1
    if args[1] == "ok":
        os.makedirs(OUT, exist_ok=True)
        os.replace(path, os.path.join(OUT, name))
        rlog(f"{name}: delivered (ack)")
    else:
        give_back(path, job, "delivery failed: " + " ".join(args[2:])[:200])
    return 0


def cmd_listen():
    ensure_state()
    for d in (OUT, CLAIMED, FAILED):
        os.makedirs(d, exist_ok=True)
    lock = open(LOCK, "w", encoding="utf-8")
    if fcntl:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except OSError:
            print("ALREADY")  # another listener is alive: the relay does NOT start one again
            return 0
    rlog("listening")
    start = time.time()
    while True:
        with open(ALIVE, "w", encoding="utf-8") as f:
            f.write(f"{os.getpid()} {int(time.time())}\n")
        reclaim()
        done = []
        for p in sorted(glob.glob(os.path.join(INBOX, "*.json"))):
            if ready(p):
                with open(p, encoding="utf-8") as f:
                    job = json.load(f)
                job["attempts"] = int(job.get("attempts") or 0) + 1
                job["claimed"] = time.time()
                dst = os.path.join(CLAIMED, os.path.basename(p))
                write_job(dst, job)  # pending until the relay acknowledges it
                os.unlink(p)
                done.append((dst, job))
        if done:
            for d, job in done:
                name = os.path.basename(d)
                print(f"JOB {d}")
                print(f"  DO: mcp__ccd_session_mgmt__send_message session_id={job['to']} message=<the text below, exactly>")
                print("  TEXT: " + job["message"])
                print(f"  ACK: {CMD} ack {name} ok")
                print(f"  (if send_message failed: {CMD} ack {name} failed <reason>)")
                rlog(f"handed to the relay: {name} (attempt {job['attempts']} of {MAX_ATTEMPTS})")
            print(f"  THEN: run the ACK line of each job; start the listener again in the background. "
                  f"Without an ack a request is handed out again after {int(CLAIM_S)} s, "
                  f"at most {MAX_ATTEMPTS} times.")
            return 0
        if time.time() - start > MAXWAIT:
            print("IDLE")
            return 0
        time.sleep(POLL)


def clear_count(rid):
    lines = _log_lines() or []
    return sum(1 for line in lines if f"Clearing session {rid}" in line)


def cmd_wait_clear(args):
    ap = argparse.ArgumentParser(prog="save-clear-relay wait-clear")
    ap.add_argument("--base", type=int, default=0)
    ap.add_argument("--timeout", type=float, default=900)
    a = ap.parse_args(args)
    rid = relay_id()
    end = time.time() + a.timeout
    while time.time() < end:
        n = clear_count(rid)
        if n > a.base:
            time.sleep(min(5, POLL))
            print(f"CLEARED relay={rid} base={a.base} now={n}")
            return 0
        time.sleep(POLL)
    print(f"TIMEOUT relay={rid} base={a.base} (no clear in the app log; wake it anyway)")
    return 0


def main(argv):
    if not argv or argv[0] in ("-h", "--help", "help"):
        print(__doc__.strip())
        return 0
    cmd, args = argv[0], argv[1:]
    if cmd == "job":
        return cmd_job(args)
    if cmd == "request":
        return cmd_request()
    if cmd == "setup":
        return cmd_setup(args)
    if cmd == "ensure":
        return cmd_ensure()
    if cmd == "status":
        return cmd_status()
    if cmd == "off":
        ensure_state()
        open(OFF, "w", encoding="utf-8").close()
        print(f"relay turned off ({OFF}). Requests are refused with exit 3 until `on`.")
        return 0
    if cmd == "on":
        try:
            os.unlink(OFF)
        except OSError:
            pass
        print(f"relay turned on. If it is not listening, send it: {wake_text()}")
        return 0
    if cmd == "rules":
        return cmd_rules()
    if cmd == "waker-rules":
        return cmd_waker_rules()
    if cmd == "listen":
        return cmd_listen()
    if cmd == "ack":
        return cmd_ack(args)
    if cmd == "clear-count":
        print(clear_count(relay_id()))
        return 0
    if cmd == "wait-clear":
        return cmd_wait_clear(args)
    print(f"unknown command {cmd!r}\n\n{__doc__.strip()}", file=sys.stderr)
    return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
