#!/usr/bin/env python3
"""save-clear command, called by the skill from Bash.

  save-clear dir                 print (and create) the snapshot folder; also the options in effect
                                 (publish_link, language, extra steps from your config)
  save-clear ask                 save-and-clear mode, BEFORE the save: with the confirm_seconds option (tmux
                                 only) tell Claude to ask "clear now?" first and start the helper that answers
                                 "go ahead" after the wait; "wait" = nothing saved, nothing cleared
  save-clear arm-resume <file>   run on_save_command (its output is appended to <file>), then: the next
                                 session started by /clear in THIS session gets <file>
  save-clear arm-clear [--now]   pick how the automatic /clear can be sent and arm the Stop hook. With the
                                 confirm_seconds option (tmux only) it also tells Claude to ask "clear now?"
                                 first, unless `ask` already asked before the save; --now skips that question
  save-clear disarm [session_id] take back THIS session's /clear request (the user answered "wait")
  save-clear rearm [session_id] [--subagents]
                                 after saving "what came after the save", arm THIS session's /clear again
                                 (--subagents: the round was a subagent's result, not a user message). Only
                                 once: a second time calls the automatic /clear off
  save-clear decision-waiting [session_id]
                                 in the first turn after a resume: a decision is waiting. When that turn ends,
                                 save-clear sends the 2nd message ("pending questions") by itself
  save-clear status              print the pending resume entries and the pending /clear requests (JSON)
"""
import json
import os
import shutil
import subprocess
import sys
import time

sys.path.insert(0, os.path.join(os.path.dirname(os.path.dirname(os.path.abspath(__file__))), "lib"))
import resume  # noqa: E402
from common import (ASKED_DIR, BIN, CONFIRM_HEADER, MAX_REARMS, all_clears, asked_path, take_asked, app_session_info, clear_key, clear_path, confirm_seconds,  # noqa: E402
                    describe_subagents, desktop_app_session, extra_steps,
                    hold_resume_requests, kill_background_tasks, language, process_start_ms, log, mark_app_wait, now_ms, pending_subagents, publish_link, read_json,
                    resume_turn_marker, run_hook_command, seed_user_config, setting, snapshot_dir,
                    stop_tasks_instruction, t3_cli, t3_session, t3_start_command, tmux_bin, transcript_of,
                    write_clear, write_json, resume_msg)


def cmd_dir():
    d = snapshot_dir()
    os.makedirs(d, exist_ok=True)
    print(d)
    print(f"publish_link: {'on' if publish_link() else 'off'}")
    if language():
        print(f"language: {language()}")
    if kill_background_tasks():
        print(stop_tasks_instruction("In save-and-clear mode, before writing the snapshot,"))
    steps = extra_steps()
    if steps:
        print("extra steps (from your save-clear config; follow them):")
        print(steps)
    return 0


def on_save(snapshot, session_id):
    """Run the user's on_save_command; append what it prints to the snapshot. Returns a status line."""
    snap = os.path.abspath(os.path.expanduser(snapshot or ""))
    if not snapshot or not os.path.isfile(snap):
        return ""
    rc, out = run_hook_command("on_save_command", "save", {
        "SAVE_CLEAR_SNAPSHOT": snap,
        "SAVE_CLEAR_SESSION_ID": os.environ.get("CLAUDE_CODE_SESSION_ID") or session_id or "",
        "SAVE_CLEAR_PROJECT_DIR": os.environ.get("CLAUDE_PROJECT_DIR") or os.getcwd(),
    }, timeout=30)
    if rc is None:
        return "on_save_command: failed to run (see the save-clear log)" if setting("on_save_command") else ""
    if rc not in (0, None):
        return f"on_save_command: exited {rc}; its output was not added"
    if not out:
        return "on_save_command: ran, nothing to add"
    try:
        with open(snap, encoding="utf-8") as f:
            body = f.read()
        if out in body:
            return "on_save_command: its output is already in the snapshot"
        with open(snap, "a", encoding="utf-8") as f:
            f.write(("" if body.endswith("\n") else "\n") + "\n" + out + "\n")
    except OSError as e:
        return f"on_save_command: could not append to the snapshot ({e})"
    return f"on_save_command: added {len(out.splitlines())} line(s) to the snapshot"


def cmd_arm_resume(args):
    note = on_save(args[0] if args else "", args[1] if len(args) > 1 else None)
    if note:
        print(note)
    ok, msg = resume.arm(args[0] if args else "", args[1] if len(args) > 1 else None)
    print(msg, file=sys.stdout if ok else sys.stderr)
    return 0 if ok else 1


def tty_of(pid):
    try:
        out = subprocess.run(["ps", "-o", "tty=", "-p", str(pid)], capture_output=True, text=True, timeout=5).stdout
    except Exception:
        return ""
    t = out.strip()
    return "" if t in ("", "?", "??") else t


def is_iterm():
    return (sys.platform == "darwin" and shutil.which("osascript") is not None
            and (os.environ.get("TERM_PROGRAM") == "iTerm.app" or os.environ.get("LC_TERMINAL") == "iTerm2"))


CHECK_TRIES = 3


def check(mode, target, sid):
    """Does the target run this session? (returncode, text) of `save-clear-send --check`.

    On a busy machine `claude agents --json` can be too slow, and the check answers "cannot-list" (exit 2)
    or does not answer at all. That says nothing about the target, so it is tried again (CHECK_TRIES in
    all) before the automatic /clear turns into "type /clear yourself"."""
    try:
        wait = float(os.environ.get("SAVE_CLEAR_CHECK_WAIT") or 4)
    except ValueError:
        wait = 4.0
    rc, out, tries = 2, "", 0
    for tries in range(1, CHECK_TRIES + 1):
        try:
            r = subprocess.run([sys.executable, os.path.join(BIN, "save-clear-send"), "--check", mode, target, sid],
                               capture_output=True, text=True, timeout=30)
            rc, out = r.returncode, r.stdout.strip()
        except subprocess.TimeoutExpired:
            rc, out = 2, f"refused: cannot-list in target {target} (the check did not answer in 30 s)"
        if rc != 2 or "cannot-list" not in out or tries == CHECK_TRIES:
            break
        time.sleep(max(wait, 0))
    if tries > 1:
        log("arm", f"check of target {target}: the session list could not be read at first; "
                   f"{'answered' if rc != 2 else 'still unreadable'} on try {tries}")
    return rc, out


def confirm_instruction(secs):
    """What Claude is told when the `confirm_seconds` option is on: ask before the clear."""
    stop = (stop_tasks_instruction("If you have not done it yet,") + " Then end") if kill_background_tasks() else "End"
    disarm = f"python3 \"{os.path.join(BIN, 'save-clear')}\" disarm"
    return (f"confirm: {secs:g} s. Automatic /clear armed, but ask first. Write no text before the question. "
            f"Call AskUserQuestion now with ONE question: header exactly \"{CONFIRM_HEADER}\"; the question, in "
            f"the user's language, asks whether to clear the conversation now and says that it goes ahead by "
            f"itself in {secs:g} s; exactly two options, in this order: 1) go ahead and clear, 2) wait, I am "
            f"still reading. A helper picks option 1 after {secs:g} s without an answer. "
            f"Answer 1: {stop} the turn with one short line; the /clear follows by itself. "
            f"Any other answer (option 2, typed text, dismissed): run `{disarm}`, do not clear, and end the "
            "turn with one line: the summary is saved and the clear waits until the user asks for it.")


def ask_instruction(secs):
    """What Claude is told by `save-clear ask`: the question comes before anything is saved."""
    return (f"ask: {secs:g} s. Before saving anything, ask. Write no text before the question. Call "
            f"AskUserQuestion now with ONE question: header exactly \"{CONFIRM_HEADER}\"; the question, in the "
            f"user's language, asks whether to save and clear the conversation now and says that it goes ahead by "
            f"itself in {secs:g} s; exactly two options, in this order: 1) go ahead: save and clear, 2) wait, I am "
            f"still reading. A helper picks option 1 after {secs:g} s without an answer. "
            "Answer 1: go on with the save-and-clear steps; `arm-clear` will not ask again. "
            "Any other answer (option 2, typed text, dismissed): save nothing and clear nothing; end the turn with "
            "one line saying the save-and-clear waits until the user asks for it (\"save-clear\").")


def cmd_ask(args):
    """Save-and-clear mode, step 0: ask "clear now?" BEFORE the save, so "wait" costs nothing and the screen
    the user is reading stays as it is while they decide. Only where the helper can answer for them (tmux)."""
    env = os.environ
    sid = env.get("CLAUDE_CODE_SESSION_ID") or (args[0] if args else "")
    secs = confirm_seconds()
    pane = env.get("TMUX_PANE") or ""
    why = ""
    if not secs:
        why = "confirm_seconds is 0"
    elif env.get("CLAUDE_JOB_DIR"):
        why = "background session"
    elif not pane or not tmux_bin():
        why = "not in a tmux pane"
    elif not sid:
        why = "no session id to check the pane with"
    else:
        rc, out = check("tmux", pane, sid)
        if rc != 0:
            why = out or f"pane {pane} could not be checked"
    if why:
        print(f"save-clear: no question here ({why}). Go on with the save.")
        return 0
    try:
        subprocess.Popen([sys.executable, os.path.join(BIN, "save-clear-confirm"), pane, f"{secs:g}"],
                         stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                         start_new_session=True)
    except OSError as e:  # nobody would answer the question for the user: do not ask it
        log("ask", f"could not start the confirm helper ({e!r}); saving without the question")
        print("save-clear: no question here (the helper did not start). Go on with the save.")
        return 0
    os.makedirs(ASKED_DIR, exist_ok=True)
    write_json(asked_path(sid), {"ts": now_ms(), "pane": pane})
    log("ask", f"the question comes before the save: waits {secs:g} s for session {sid[:8]}")
    print(ask_instruction(secs))
    return 0


def t3_run(cmd, stdin=None, timeout=60):
    """(returncode, stdout, stderr) of a T3 CLI call; (None, "", why) when it could not run."""
    try:
        r = subprocess.run(cmd, input=stdin, capture_output=True, text=True, encoding="utf-8", timeout=timeout)
    except (OSError, subprocess.SubprocessError) as e:
        return None, "", repr(e)
    return r.returncode, r.stdout.strip(), r.stderr.strip()


def t3_thread_info(cli, thread):
    """This thread's {title, providerInstanceId, model, link, ...} from `t3 thread show --json`, or {}."""
    rc, out, _ = t3_run([cli, "thread", "show", "--json", "--messages", "0", thread], timeout=30)
    try:
        return (json.loads(out).get("thread") or {}) if rc == 0 else {}
    except (ValueError, AttributeError):
        return {}


def t3_message(snapshot):
    return (resume_msg() + "\n\n(save-clear: this thread continues an earlier one from its saved summary. If no "
            f"\"Previous session (auto-resume)\" context came with this message, read {snapshot} and continue "
            "from it.)")


def arm_clear_t3(env, sid):
    """T3 Code: the "clear" is a new thread in the same project that starts from the saved summary.
    Returns (mode, target, note)."""
    cli = t3_cli(env)
    if not cli:
        return "manual", "", "T3 Code session, but its CLI was not found (T3CODE_CLI_PATH, or t3 on PATH)"
    # The old thread's process lives on: its subagents report THERE, never to the new thread. Wait for them.
    try:
        agents = [a for a in pending_subagents(transcript_of(sid), sid, process_start_ms()) if a.get("why") == "running"] \
            if sid else []
    except Exception as e:  # a broken check must not block the clear
        log("arm", f"subagent check failed for {sid[:8]} ({e!r})")
        agents = []
    if agents:
        return "t3-wait", "", f"{len(agents)} subagent(s) still at work: {describe_subagents(agents)}"
    entry = resume.bind_t3(sid, resume.T3_PENDING)
    if not entry:
        return "manual", "", "T3 Code session with no armed resume for this session (run arm-resume first)"
    here = env.get("T3CODE_THREAD_ID") or ""
    info = t3_thread_info(cli, here)
    title = info.get("title") or ""
    title = (title + " (continued)") if title and not title.endswith("(continued)") else (title or "Continued")
    folder = env.get("CLAUDE_PROJECT_DIR") or os.getcwd()
    cmd = t3_start_command(cli, folder, "", title, info.get("providerInstanceId") or "", info.get("model") or "")
    rc, out, err = t3_run(cmd, stdin=t3_message(entry["snapshot"]))
    new = ""
    try:
        new = str((json.loads(out) if rc == 0 else {}).get("threadId") or "")
    except (ValueError, AttributeError):
        pass
    if not new:
        resume.bind_t3(sid, None)
        why = ((err or out).splitlines() or [""])[-1][:300] or f"exit {rc}"
        log("arm", f"mode=t3 for session {sid[:8]}: t3 thread start failed ({why})")
        return "manual", "", f"T3 Code: could not start the new thread ({why})"
    resume.bind_t3(sid, new)
    log("arm", f"mode=t3 for session {sid[:8]}: thread {here} continues in {new}")
    return "t3", new, ""


def cmd_arm_clear(args):
    env = os.environ
    sid = env.get("CLAUDE_CODE_SESSION_ID") or (args[0] if args else "")
    ep = env.get("CLAUDE_CODE_ENTRYPOINT") or "cli"
    t3 = t3_session(env)
    if t3 and env.get("TMUX_PANE") and tmux_bin() and sid and check("tmux", env["TMUX_PANE"], sid)[0] == 0:
        t3 = False  # a pane proven to run this session wins, as below for an inherited app entrypoint
    if t3:
        # Checked first: T3 is not a terminal (no tmux to type into) and not the Claude desktop app (its
        # relay and clear_session belong to other sessions).
        mode, target, note = arm_clear_t3(env, sid)
        print(f"save-clear: mode={mode} target={target or 'none'} entrypoint={ep}" + (f" ({note})" if note else ""))
        if mode == "t3-wait":
            log("arm", f"mode=t3 for session {sid[:8]}: {note}; no new thread yet")
            print("subagents running: their results come back to THIS thread only (a new thread never gets "
                  "them). Do not start a new thread now: end the turn with the step 7 reply, saying the move to a "
                  "new thread waits for these subagents. Add each result to the snapshot under \"## After the "
                  "save\"; when none is left, run save-clear arm-clear again.")
            return 0
        if mode == "manual":
            print("No automatic clear here. Tell the user to start a new thread in this project and ask it to "
                  "read the snapshot (its path is in the snapshot step above); say why, from the note.")
            return 0
        if kill_background_tasks():
            print(stop_tasks_instruction("If you have not done it yet, now, before ending the turn,"))
        print(f"T3 Code: the conversation continues in the new thread {target}, which starts from the summary "
              "by itself. This thread stays as it is. If the mcp__t3-code__t3_thread_update tool exists (load it "
              f"with ToolSearch if it is only listed), rename this thread to its title plus \" (continued in "
              f"{target})\". Then end the turn with one short line telling the user to open the new thread "
              "(T3 lists it in this project), and run nothing else.")
        return 0
    pid = env.get("CLAUDE_PID") or str(os.getppid())
    tty = tty_of(pid)
    target, note = "", ""
    pane_ok = False
    if ep != "cli" and not env.get("CLAUDE_JOB_DIR") and env.get("TMUX_PANE") and tmux_bin() and sid:
        # A terminal Claude can inherit an app entrypoint (a tmux server started from a desktop app session
        # keeps CLAUDE_CODE_ENTRYPOINT=claude-desktop for every pane). The pane wins only when the check
        # proves it runs THIS session; otherwise TMUX_PANE is an app's stale one and nothing is typed there.
        pane_ok = check("tmux", env["TMUX_PANE"], sid)[0] == 0
    if env.get("CLAUDE_JOB_DIR"):
        mode, target = "bg", os.path.basename(env["CLAUDE_JOB_DIR"])
        if not tmux_bin():
            mode, note = "manual", "background session, but tmux is not installed"
    elif ep != "cli" and not pane_ok:
        # Desktop app, IDE, SDK: an inherited TMUX_PANE points at ANOTHER session. Never type there.
        mode = "app"
    elif env.get("TMUX_PANE") and tmux_bin():
        mode, target = "tmux", env["TMUX_PANE"]
    elif tty.startswith("ttys") and is_iterm():
        # Through AppleScript the helper cannot tell whether the prompt is empty or the session idle,
        # so it could submit a half-typed draft. It does not type there.
        mode, note = "manual", "iTerm2 without tmux: an empty prompt cannot be checked there"
    else:
        mode = "manual"
        note = "no tmux and no iTerm2 to type into"
    if mode == "tmux" and not pane_ok:
        if not sid:
            mode, note = "manual", "no session id to check the target with"
        else:
            rc, out = check(mode, target, sid)
            if rc != 0:
                mode, note = "manual", out or f"target {target} could not be checked"
    print(f"save-clear: mode={mode} target={target or 'none'} entrypoint={ep}" + (f" ({note})" if note else ""))
    if mode in ("app", "manual"):
        log("arm", f"mode={mode} for session {sid[:8] or '?'}: no automatic /clear{' - ' + note if note else ''}")
        if mode == "manual":
            print("No automatic /clear here. Tell the user to type /clear; the summary comes back by itself.")
        else:
            # The app's clear ends this process; a subagent still at work would die with it (see common.py).
            # Only the desktop app's clear_session ends the process; IDE and SDK sessions have no such tool.
            # Only subagents still running wait here; one that just finished is handled by the clear guard.
            # A session started from Remote Control is never cleared by a tool (the relay prints RC-LOCKED and
            # the reply is "You can /clear now."), and a /clear the user types keeps the process and its
            # subagents (seen on 11/11/2026): nothing to wait for.
            agents, start = [], None
            spawned = app_session_info(env.get("CLAUDE_CODE_HOST_SESSION_ID") or "").get("remoteControlSpawn")
            if sid and desktop_app_session() and not spawned:
                try:
                    start = process_start_ms()
                    agents = [a for a in pending_subagents(transcript_of(sid), sid, start) if a.get("why") == "running"]
                except Exception as e:  # a broken check must not block the clear
                    log("arm", f"subagent check failed for {sid[:8]} ({e!r}); the usual app steps")
            if agents:
                # No kill_background_tasks line here: a held subagent may need them; the Stop hook's finish
                # step repeats it right before the real clear.
                mark_app_wait(sid, agents, start_ms=start)
                hold_resume_requests(env.get("CLAUDE_CODE_HOST_SESSION_ID") or "")
                log("arm", f"mode=app for session {sid[:8]}: {len(agents)} subagent(s) still at work, the clear waits")
                print(f"subagents running: {len(agents)} ({describe_subagents(agents)}). In the desktop app, "
                      "clear_session ends this session's process when the turn ends, and they would die with it. "
                      "Do not run the relay steps and do not call clear_session now: end the turn with the step 7 "
                      "reply, saying the clear waits for these subagents. Each result comes back here as a task "
                      "notification: handle it and add it to the snapshot under \"## After the save\". When none "
                      "is left, the Stop hook tells you how to finish the clear.")
                return 0
            if kill_background_tasks():
                print(stop_tasks_instruction("If you have not done it yet, before calling clear_session,"))
            print("Not a terminal session. If the clear_session tool exists: run save-clear-relay ensure, then "
                  "save-clear-relay request (the relay sends the resume), then call clear_session with session_id "
                  "\"self\"; otherwise tell the user to type /clear.")
        return 0
    key = clear_key(job=target) if mode == "bg" else clear_key(sid)
    write_clear({"session_id": sid, "mode": mode, "target": target, "key": key, "ts": now_ms()})
    log("arm", f"auto-clear armed: mode={mode} target={target} session {sid[:8]}")
    # The question is for a terminal the helper can press Enter in. `--now`: the user just asked for the
    # clear (after a "wait"), so asking again would only be in the way.
    asked = take_asked(sid)  # `ask` put the question before the save: never a second time
    secs = confirm_seconds() if mode == "tmux" and "--now" not in args and not asked else 0
    if asked:
        log("arm", f"session {sid[:8]}: the question was asked before the save; not asking again")
    if secs:
        try:
            subprocess.Popen([sys.executable, os.path.join(BIN, "save-clear-confirm"), target, f"{secs:g}"],
                             stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                             start_new_session=True)
        except OSError as e:  # nobody would answer the question for the user: do not ask it
            log("arm", f"could not start the confirm helper ({e!r}); clearing without the question")
        else:
            log("arm", f"confirm: the question waits {secs:g} s for session {sid[:8]}")
            print(confirm_instruction(secs))
            return 0
    if kill_background_tasks():
        print(stop_tasks_instruction("If you have not done it yet, now, before ending the turn,"))
    print("Automatic /clear armed: end the turn now with one short line.")
    return 0


def own_clear(sid, job):
    """This session's pending /clear request (same session id, or same --bg job), or None."""
    for flag in all_clears():
        if (sid and flag.get("session_id") == sid) or \
                (job and flag.get("mode") == "bg" and flag.get("target") == job):
            return flag
    return None


def cmd_rearm(args):
    pos = [a for a in args if not a.startswith("--")]
    sid = os.environ.get("CLAUDE_CODE_SESSION_ID") or (pos[0] if pos else "")
    job = os.path.basename(os.environ.get("CLAUDE_JOB_DIR") or "")
    flag = own_clear(sid, job)
    if not flag:
        print(f"save-clear: no /clear request of this session to re-arm (session {sid[:8] or '?'})", file=sys.stderr)
        return 1
    subagents = "--subagents" in args  # a subagent result is outside the single re-arm (own limit in the Stop hook)
    if not subagents and int(flag.get("rearms") or 0) >= MAX_REARMS:
        # One re-arm already: another would be the loop the user complained about. Call the clear off.
        key = flag.get("key") or (clear_key(job=job) if job and flag.get("mode") == "bg" else clear_key(sid))
        try:
            os.unlink(clear_path(key))
        except OSError:
            pass
        log("arm", f"rearm refused: already re-armed {MAX_REARMS} time(s); automatic clear called off "
                   f"(session {sid[:8] or '?'})")
        print(f"not re-armed: the automatic /clear was already put off {MAX_REARMS} time(s), so it is called off "
              "now (no loop). Keep the \"## After the save\" section, and end the turn with one short line: the "
              "summary is saved and the clear waits until the user says \"save-clear\" (or types /clear).")
        return 0
    flag["ts"] = flag["armed_at"] = now_ms()
    if not subagents:
        flag["rearms"] = int(flag.get("rearms") or 0) + 1
    counter = "agent_rounds" if subagents else "deltas"  # subagent results do not use up the user's 3 rounds
    flag[counter] = flag.get(counter, 0) + 1
    # This round was the user's message (or a subagent's result), which is what kept the session busy:
    # not a leftover task.
    flag.pop("busy_rearm", None)
    flag["key"] = flag.get("key") or (clear_key(job=job) if job and flag.get("mode") == "bg" else clear_key(sid))
    write_clear(flag)
    print(f"re-armed (round {flag[counter]} after the save" + (", subagent results)" if subagents else ")"))
    return 0


def cmd_disarm(args):
    """Take back this session's /clear request (the user answered "wait"). The resume stays armed."""
    pos = [a for a in args if not a.startswith("--")]
    sid = os.environ.get("CLAUDE_CODE_SESSION_ID") or (pos[0] if pos else "")
    job = os.path.basename(os.environ.get("CLAUDE_JOB_DIR") or "")
    flag = own_clear(sid, job)
    if flag:
        key = flag.get("key") or (clear_key(job=job) if job and flag.get("mode") == "bg" else clear_key(sid))
        try:
            os.unlink(clear_path(key))
        except OSError:
            pass
        log("arm", f"disarmed: the user asked to wait (session {sid[:8] or '?'})")
    rearm = f"python3 \"{os.path.join(BIN, 'save-clear')}\" arm-clear --now"
    print(("Disarmed: no automatic /clear now." if flag else "No /clear request of this session was armed.")
          + " The summary stays saved and comes back after any /clear. When the user asks to clear: if the "
          "conversation moved on since the save, add what came after to the snapshot in a section "
          f"\"## After the save\"; then run `{rearm}` (no question this time) and end the turn.")
    return 0


def cmd_decision_waiting(args):
    """Flag, in this session's resume-turn marker, that a decision is waiting (see hooks/resume_turn_guard.py)."""
    sid = (args[0] if args else "") or os.environ.get("CLAUDE_CODE_SESSION_ID") or ""
    marker = resume_turn_marker(sid) if sid else ""
    m = read_json(marker) if marker and os.path.exists(marker) else None
    if not isinstance(m, dict):
        print("save-clear: not in a resume turn (no marker for this session); nothing to do.")
        log("resume-turn", f"{sid[:8] or '?'}: decision-waiting without a marker, ignored")
        return 0
    m["pending"] = True
    write_json(marker, m)
    log("resume-turn", f"{sid[:8]}: a decision is waiting; the 2nd message follows when the turn ends")
    print("ok: write the summary now; the pending question comes in a second message.")
    return 0


def main(argv):
    seed_user_config()  # also here, in case the SessionStart hook has not run yet
    if not argv or argv[0] in ("-h", "--help", "help"):
        print(__doc__.strip())
        return 0
    cmd, args = argv[0], argv[1:]
    if cmd == "dir":
        return cmd_dir()
    if cmd == "ask":
        return cmd_ask(args)
    if cmd == "arm-resume":
        return cmd_arm_resume(args)
    if cmd == "arm-clear":
        return cmd_arm_clear(args)
    if cmd == "rearm":
        return cmd_rearm(args)
    if cmd == "disarm":
        return cmd_disarm(args)
    if cmd == "decision-waiting":
        return cmd_decision_waiting(args)
    if cmd == "status":
        print(json.dumps({"resume": resume.read_entries(), "clear": all_clears()}, indent=2))
        return 0
    print(f"save-clear: unknown command {cmd!r}\n\n{__doc__.strip()}", file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
