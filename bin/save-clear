#!/usr/bin/env python3
"""save-clear command, called by the skill from Bash.

  save-clear dir                 print (and create) the snapshot folder; also the options in effect
                                 (publish_link, language, extra steps from your config)
  save-clear arm-resume <file>   run on_save_command (its output is appended to <file>), then: the next
                                 session started by /clear in THIS session gets <file>
  save-clear arm-clear           pick how the automatic /clear can be sent and arm the Stop hook
  save-clear rearm [session_id]  after saving "what came after the save", arm THIS session's /clear again
  save-clear status              print the pending resume entries and the pending /clear requests (JSON)
"""
import json
import os
import shutil
import subprocess
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.dirname(os.path.abspath(__file__))), "lib"))
import resume  # noqa: E402
from common import (BIN, all_clears, clear_key, extra_steps, language, log, now_ms,  # noqa: E402
                    publish_link, run_hook_command, seed_user_config, setting, snapshot_dir, tmux_bin,
                    write_clear)


def cmd_dir():
    d = snapshot_dir()
    os.makedirs(d, exist_ok=True)
    print(d)
    print(f"publish_link: {'on' if publish_link() else 'off'}")
    if language():
        print(f"language: {language()}")
    steps = extra_steps()
    if steps:
        print("extra steps (from your save-clear config; follow them):")
        print(steps)
    return 0


def on_save(snapshot, session_id):
    """Run the user's on_save_command; append what it prints to the snapshot. Returns a status line."""
    snap = os.path.abspath(os.path.expanduser(snapshot or ""))
    if not snapshot or not os.path.isfile(snap):
        return ""
    rc, out = run_hook_command("on_save_command", "save", {
        "SAVE_CLEAR_SNAPSHOT": snap,
        "SAVE_CLEAR_SESSION_ID": os.environ.get("CLAUDE_CODE_SESSION_ID") or session_id or "",
        "SAVE_CLEAR_PROJECT_DIR": os.environ.get("CLAUDE_PROJECT_DIR") or os.getcwd(),
    }, timeout=30)
    if rc is None:
        return "on_save_command: failed to run (see the save-clear log)" if setting("on_save_command") else ""
    if rc not in (0, None):
        return f"on_save_command: exited {rc}; its output was not added"
    if not out:
        return "on_save_command: ran, nothing to add"
    try:
        with open(snap, encoding="utf-8") as f:
            body = f.read()
        if out in body:
            return "on_save_command: its output is already in the snapshot"
        with open(snap, "a", encoding="utf-8") as f:
            f.write(("" if body.endswith("\n") else "\n") + "\n" + out + "\n")
    except OSError as e:
        return f"on_save_command: could not append to the snapshot ({e})"
    return f"on_save_command: added {len(out.splitlines())} line(s) to the snapshot"


def cmd_arm_resume(args):
    note = on_save(args[0] if args else "", args[1] if len(args) > 1 else None)
    if note:
        print(note)
    ok, msg = resume.arm(args[0] if args else "", args[1] if len(args) > 1 else None)
    print(msg, file=sys.stdout if ok else sys.stderr)
    return 0 if ok else 1


def tty_of(pid):
    try:
        out = subprocess.run(["ps", "-o", "tty=", "-p", str(pid)], capture_output=True, text=True, timeout=5).stdout
    except Exception:
        return ""
    t = out.strip()
    return "" if t in ("", "?", "??") else t


def is_iterm():
    return (sys.platform == "darwin" and shutil.which("osascript") is not None
            and (os.environ.get("TERM_PROGRAM") == "iTerm.app" or os.environ.get("LC_TERMINAL") == "iTerm2"))


def check(mode, target, sid):
    r = subprocess.run([sys.executable, os.path.join(BIN, "save-clear-send"), "--check", mode, target, sid],
                       capture_output=True, text=True, timeout=30)
    return r.returncode, r.stdout.strip()


def cmd_arm_clear(args):
    env = os.environ
    sid = env.get("CLAUDE_CODE_SESSION_ID") or (args[0] if args else "")
    ep = env.get("CLAUDE_CODE_ENTRYPOINT") or "cli"
    pid = env.get("CLAUDE_PID") or str(os.getppid())
    tty = tty_of(pid)
    target, note = "", ""
    if env.get("CLAUDE_JOB_DIR"):
        mode, target = "bg", os.path.basename(env["CLAUDE_JOB_DIR"])
        if not tmux_bin():
            mode, note = "manual", "background session, but tmux is not installed"
    elif ep != "cli":
        # Desktop app, IDE, SDK: an inherited TMUX_PANE points at ANOTHER session. Never type there.
        mode = "app"
    elif env.get("TMUX_PANE") and tmux_bin():
        mode, target = "tmux", env["TMUX_PANE"]
    elif tty.startswith("ttys") and is_iterm():
        # Through AppleScript the helper cannot tell whether the prompt is empty or the session idle,
        # so it could submit a half-typed draft. It does not type there.
        mode, note = "manual", "iTerm2 without tmux: an empty prompt cannot be checked there"
    else:
        mode = "manual"
        note = "no tmux and no iTerm2 to type into"
    if mode == "tmux":
        if not sid:
            mode, note = "manual", "no session id to check the target with"
        else:
            rc, out = check(mode, target, sid)
            if rc != 0:
                mode, note = "manual", out or f"target {target} could not be checked"
    print(f"save-clear: mode={mode} target={target or 'none'} entrypoint={ep}" + (f" ({note})" if note else ""))
    if mode in ("app", "manual"):
        log("arm", f"mode={mode} for session {sid[:8] or '?'}: no automatic /clear{' - ' + note if note else ''}")
        if mode == "manual":
            print("No automatic /clear here. Tell the user to type /clear; the summary comes back by itself.")
        else:
            print("Not a terminal session. If the clear_session tool exists: run save-clear-relay request "
                  "(optional relay), then call clear_session with session_id \"self\"; otherwise tell the user "
                  "to type /clear.")
        return 0
    key = clear_key(job=target) if mode == "bg" else clear_key(sid)
    write_clear({"session_id": sid, "mode": mode, "target": target, "key": key, "ts": now_ms()})
    log("arm", f"auto-clear armed: mode={mode} target={target} session {sid[:8]}")
    print("Automatic /clear armed: end the turn now with one short line.")
    return 0


def own_clear(sid, job):
    """This session's pending /clear request (same session id, or same --bg job), or None."""
    for flag in all_clears():
        if (sid and flag.get("session_id") == sid) or \
                (job and flag.get("mode") == "bg" and flag.get("target") == job):
            return flag
    return None


def cmd_rearm(args):
    sid = os.environ.get("CLAUDE_CODE_SESSION_ID") or (args[0] if args else "")
    job = os.path.basename(os.environ.get("CLAUDE_JOB_DIR") or "")
    flag = own_clear(sid, job)
    if not flag:
        print(f"save-clear: no /clear request of this session to re-arm (session {sid[:8] or '?'})", file=sys.stderr)
        return 1
    flag["ts"] = flag["armed_at"] = now_ms()
    flag["deltas"] = flag.get("deltas", 0) + 1
    flag["key"] = flag.get("key") or (clear_key(job=job) if job and flag.get("mode") == "bg" else clear_key(sid))
    write_clear(flag)
    print(f"re-armed (round {flag['deltas']} after the save)")
    return 0


def main(argv):
    seed_user_config()  # also here, in case the SessionStart hook has not run yet
    if not argv or argv[0] in ("-h", "--help", "help"):
        print(__doc__.strip())
        return 0
    cmd, args = argv[0], argv[1:]
    if cmd == "dir":
        return cmd_dir()
    if cmd == "arm-resume":
        return cmd_arm_resume(args)
    if cmd == "arm-clear":
        return cmd_arm_clear(args)
    if cmd == "rearm":
        return cmd_rearm(args)
    if cmd == "status":
        print(json.dumps({"resume": resume.read_entries(), "clear": all_clears()}, indent=2))
        return 0
    print(f"save-clear: unknown command {cmd!r}\n\n{__doc__.strip()}", file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
